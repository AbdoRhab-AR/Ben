@model IEnumerable<KOSS.Web.Models.WorkOrder>
@{
    ViewData["Title"] = "خطوط الإنتاج والتصنيع وفحص الجودة بالمصنع";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-industry text-warning me-2"></i> خطوط الإنتاج والتصنيع وفحص الجودة</h3>
        <p class="text-muted mb-0">متابعة عمليات القص، والتجميع، والمفصلات، وفحص الجودة والمطابقة الفنية</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم أمر التشغيل</th>
                        <th>طلب المطبخ والعميل</th>
                        <th>حالة التصنيع بالمصنع</th>
                        <th>تاريخ الانتهاء المستهدف</th>
                        <th>الإجراءات المتاحة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">لا توجد أوامر تشغيل قيد التصنيع حالياً.</td></tr>
                    }
                    @foreach (var wo in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@wo.OrderNumber</strong></td>
                            <td>
                                <strong>@(wo.KitchenRequest?.Customer?.Name ?? "-")</strong>
                                <small class="d-block text-muted">@(wo.KitchenRequest?.RequestNumber ?? "")</small>
                            </td>
                            <td><span class="badge bg-warning text-dark px-3 py-2">@wo.Status.ToArabic()</span></td>
                            <td><strong>@(wo.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@wo.KitchenRequestId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-clipboard-check me-1"></i> فحص الجودة ومتابعة المراحل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>