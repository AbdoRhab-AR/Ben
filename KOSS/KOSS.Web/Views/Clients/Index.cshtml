@model IEnumerable<KOSS.Web.Models.Customer>
@{
    ViewData["Title"] = "دليل العملاء";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-users text-dark me-2"></i> دليل العملاء وسجل المشاريع</h3>
        <p class="text-muted mb-0">إدارة بيانات العملاء والتواصل وسجل العقود والمطابخ</p>
    </div>
    <a asp-action="Create" class="btn btn-koss-primary">
        <i class="fa-solid fa-plus me-1"></i> إضافة عميل جديد
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم العميل</th>
                        <th>رقم الهاتف</th>
                        <th>المدينة والمنطقة</th>
                        <th>العنوان</th>
                        <th>عدد المشاريع</th>
                        <th>تاريخ التسجيل</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا يوجد عملاء مسجلين حالياً.</td></tr>
                    }
                    @foreach (var cust in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">#@cust.Id</strong></td>
                            <td><strong class="text-dark">@cust.Name</strong></td>
                            <td><span dir="ltr">@cust.Phone</span></td>
                            <td>@(cust.District ?? "-")</td>
                            <td><small class="text-muted">@(cust.Address ?? "-")</small></td>
                            <td><span class="badge bg-light text-dark border">@(cust.KitchenRequests?.Count ?? 0) مشاريع</span></td>
                            <td class="text-muted"><small>@cust.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
