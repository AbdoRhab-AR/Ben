@model KOSS.Web.Models.Customer
@{
    ViewData["Title"] = "تسجيل عميل جديد";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-user-plus text-primary me-2"></i> تسجيل عميل جديد</h3>
        <p class="text-muted mb-0">إضافة بيانات العميل إلى قاعدة البيانات المركزية</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة لدليل العملاء
    </a>
</div>

<div class="card card-custom" style="max-width: 700px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold"></label>
                <input asp-for="Name" class="form-control" placeholder="الاسم ثلاثي" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label fw-bold"></label>
                    <input asp-for="Phone" class="form-control" placeholder="09xxxxxxxx" required />
                    <span asp-validation-for="Phone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="District" class="form-label fw-bold"></label>
                    <input asp-for="District" class="form-control" placeholder="المدينة أو المنطقة" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label fw-bold"></label>
                <input asp-for="Address" class="form-control" placeholder="العنوان التفصيلي أو أقرب نقطة دالة" />
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-bold"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="ملاحظات عامة حول العميل..."></textarea>
            </div>

            <hr />
            <button type="submit" class="btn btn-koss-primary px-4 py-2">
                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ العميل
            </button>
        </form>
    </div>
</div>
