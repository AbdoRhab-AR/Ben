@model KOSS.Web.Models.Customer
@{
    ViewData["Title"] = "إضافة عميل جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-user-plus text-primary me-2"></i> تسجيل وإضافة عميل جديد
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">اسم العميل الكامل</label>
                        <input asp-for="Name" class="form-control" placeholder="الاسم الثلاثي أو اسم الشركة..." required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-bold">رقم الهاتف الأساسي</label>
                        <input asp-for="Phone" class="form-control" placeholder="091XXXXXXX" required />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="District" class="form-label fw-bold">المدينة / المنطقة</label>
                            <input asp-for="District" class="form-control" placeholder="طرابلس، بنغازي، مصراتة..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Address" class="form-label fw-bold">العنوان التفصيلي</label>
                            <input asp-for="Address" class="form-control" placeholder="الشارع، علامة مميزة..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات عامة حول العميل</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="تفضيلات العميل، أوقات التواصل المناسبة..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-save me-1"></i> حفظ بيانات العميل
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
