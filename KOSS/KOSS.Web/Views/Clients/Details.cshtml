@model KOSS.Web.Models.Customer
@{
    ViewData["Title"] = "ملف العميل: " + Model.Name;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-id-card text-primary me-2"></i> ملف العميل: @Model.Name</h3>
        <p class="text-muted mb-0">سجل طلبات المطابخ، الاستفسارات، والعقود المسجلة</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Requests" asp-action="Create" asp-route-customerId="@Model.Id" class="btn btn-koss-primary">
            <i class="fa-solid fa-plus me-1"></i> فتح طلب مطبخ جديد
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">العودة للعملاء</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-custom p-3">
            <h6 class="fw-bold text-muted mb-2">بيانات الاتصال</h6>
            <p class="mb-1"><i class="fa-solid fa-phone me-2 text-primary"></i> <span dir="ltr">@Model.Phone</span></p>
            <p class="mb-1"><i class="fa-solid fa-location-dot me-2 text-danger"></i> @(Model.District ?? "-") - @(Model.Address ?? "-")</p>
            <p class="mb-0 text-muted small"><i class="fa-regular fa-calendar me-2"></i> تاريخ التسجيل: @Model.CreatedAt.ToString("yyyy/MM/dd")</p>
        </div>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header card-header-custom">
        <i class="fa-solid fa-folder-tree text-primary me-1"></i> طلبات ومشاريع المطبخ للعميل (@(Model.KitchenRequests?.Count ?? 0))
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>الموقع</th>
                        <th>النوع والتخطيط</th>
                        <th>الحالة</th>
                        <th>تاريخ الفتح</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.KitchenRequests == null || !Model.KitchenRequests.Any())
                    {
                        <tr><td colspan="6" class="text-center py-4 text-muted">لا توجد طلبات مطابخ مسجلة لهذا العميل.</td></tr>
                    }
                    else
                    {
                        foreach (var req in Model.KitchenRequests)
                        {
                            <tr>
                                <td><strong class="text-primary">@req.RequestNumber</strong></td>
                                <td>@req.Location</td>
                                <td>@req.ProjectType - @req.LayoutType</td>
                                <td><span class="badge bg-primary">@req.Status</span></td>
                                <td class="text-muted"><small>@req.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                                <td>
                                    <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
