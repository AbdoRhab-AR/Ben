@model KOSS.Web.Models.Client
@{
    ViewBag.Title = "ملف العميل - " + Model.Name;
}

<div class="page-header">
    <h2>📄 ملف العميل: <strong>@Model.Name</strong>
        <a href="@Url.Action("Index")" class="btn btn-default pull-left">← العودة للقائمة</a>
        <a href="@Url.Action("Edit", new{id=Model.Id})" class="btn btn-warning pull-left" style="margin-left:5px;">✏️ تعديل</a>
    </h2>
</div>

<div class="row">
    <!-- بيانات العميل -->
    <div class="col-md-4">
        <div class="panel panel-default">
            <div class="panel-heading"><h4>👤 بيانات العميل</h4></div>
            <div class="panel-body">
                <table class="table table-condensed">
                    <tr><td><strong>الاسم</strong></td><td>@Model.Name</td></tr>
                    <tr><td><strong>الهاتف</strong></td><td dir="ltr">@Model.Phone</td></tr>
                    @if (!string.IsNullOrEmpty(Model.Phone2))
                    {
                        <tr><td><strong>هاتف 2</strong></td><td dir="ltr">@Model.Phone2</td></tr>
                    }
                    <tr><td><strong>المنطقة</strong></td><td>@Model.District</td></tr>
                    <tr><td><strong>العنوان</strong></td><td>@Model.Address</td></tr>
                    <tr>
                        <td><strong>الحالة</strong></td>
                        <td>
                            <span class="label @(Model.Status == ClientStatus.Interested ? "label-success" : "label-default")">
                                @(Model.Status == ClientStatus.Interested ? "✅ مهتم" : "❌ غير مهتم")
                            </span>
                        </td>
                    </tr>
                    <tr><td><strong>تاريخ التسجيل</strong></td><td>@Model.CreatedAt.ToString("yyyy/MM/dd")</td></tr>
                    <tr><td><strong>مسجَّل بواسطة</strong></td><td>@Model.CreatedBy</td></tr>
                </table>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="alert alert-info"><strong>ملاحظات:</strong> @Model.Notes</div>
                }

                <!-- زر تغيير الحالة -->
                @using (Html.BeginForm("SetStatus", "Clients", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    if (Model.Status == ClientStatus.Interested)
                    {
                        <input type="hidden" name="status" value="2" />
                        <button type="submit" class="btn btn-default btn-block">❌ تحديد كـ"غير مهتم"</button>
                    }
                    else
                    {
                        <input type="hidden" name="status" value="1" />
                        <button type="submit" class="btn btn-success btn-block">✅ تحديد كـ"مهتم"</button>
                    }
                }
            </div>
        </div>
    </div>

    <!-- العقود -->
    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4>📋 عقود العميل (@Model.Contracts.Count)
                    <a href="@Url.Action("Create","Contracts", new{clientId=Model.Id})"
                       class="btn btn-sm btn-success pull-left">➕ عقد جديد</a>
                </h4>
            </div>
            <div class="panel-body">
                @if (!Model.Contracts.Any())
                {
                    <div class="alert alert-info">لا توجد عقود لهذا العميل حتى الآن.</div>
                }
                else
                {
                    foreach (var contract in Model.Contracts.OrderByDescending(c => c.CreatedAt))
                    {
                        <div class="contract-card">
                            <div class="row">
                                <div class="col-md-6">
                                    <strong>@contract.ContractNumber</strong> &nbsp;
                                    <span class="label label-primary">@contract.Status</span>
                                </div>
                                <div class="col-md-6 text-left">
                                    <strong>@contract.TotalValue.ToString("N3") د.ل</strong>
                                    <small>مدفوع: @contract.TotalPaid.ToString("N3") د.ل</small>
                                </div>
                            </div>
                            <div class="progress" style="margin:5px 0;">
                                @{ double pct = contract.TotalValue > 0 ? (double)(contract.TotalPaid / contract.TotalValue * 100) : 0; }
                                <div class="progress-bar @(pct >= 70 ? "progress-bar-success" : "progress-bar-warning")"
                                     style="width:@pct.ToString("F0")%">@pct.ToString("F0")%</div>
                            </div>
                            <small>الوحدات: @contract.Units.Count | @contract.CreatedAt.ToString("yyyy/MM/dd")</small>
                            <div class="pull-left">
                                <a href="@Url.Action("RecordPayment","Finance",new{contractId=contract.Id})"
                                   class="btn btn-xs btn-success">💰 دفعة</a>
                                <a href="@Url.Action("Ledger","Finance",new{id=contract.Id})"
                                   class="btn btn-xs btn-info">📊 كشف</a>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
