@model KOSS.Web.Models.Client
@{
    ViewBag.Title = "تعديل بيانات العميل - " + Model.Name;
}

<div class="page-header">
    <h2>✏️ تعديل بيانات العميل: <strong>@Model.Name</strong>
        <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-default pull-left">← إلغاء وعودة للملف</a>
    </h2>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading"><h4>تحديث المعلومات</h4></div>
            <div class="panel-body">
                @using (Html.BeginForm("Edit", "Clients", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.CreatedAt)
                    @Html.HiddenFor(m => m.CreatedBy)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="form-group">
                        @Html.LabelFor(m => m.Name, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", autofocus = "autofocus" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Phone, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control", dir = "ltr" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Phone2, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.Phone2, new { @class = "form-control", dir = "ltr" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.District, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.District, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Address, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = 2 })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Status, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.EnumDropDownListFor(m => m.Status, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Notes, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 2 })
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-8 col-md-offset-4">
                            <button type="submit" class="btn btn-warning btn-lg">
                                💾 حفظ التعديلات
                            </button>
                            <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-default btn-lg">إلغاء</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
