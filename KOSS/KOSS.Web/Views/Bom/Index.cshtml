@model IEnumerable<KOSS.Web.Models.PurchaseOrder>
@{
    ViewBag.Title = "قوائم المواد";
}

<div class="page-header">
    <h2>📦 قوائم المواد وأوامر الشراء</h2>
</div>

<div class="panel panel-default">
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-koss">
                <tr>
                    <th>رقم PO</th><th>العميل</th><th>التكلفة التقديرية (د.ل)</th>
                    <th>الحالة</th><th>تاريخ الإنشاء</th><th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var po in Model)
                {
                    <tr>
                        <td><strong>@po.PoNumber</strong></td>
                        <td>@(po.Contract != null && po.Contract.Client != null ? po.Contract.Client.Name : "-")</td>
                        <td>@po.TotalEstimatedCost.ToString("N3")</td>
                        <td><span class="label label-info">@po.Status</span></td>
                        <td>@po.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a href="@Url.Action("Details", new{id=po.Id})"
                               class="btn btn-xs btn-info">📋 تفاصيل</a>
                            @if (po.Status == PurchaseOrderStatus.Draft)
                            {
                                using (Html.BeginForm("SendToWarehouse", "Bom", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@po.Id" />
                                    <button type="submit" class="btn btn-xs btn-warning">📤 إرسال للمستودع</button>
                                }
                            }
                            @if (po.Status == PurchaseOrderStatus.Approved)
                            {
                                using (Html.BeginForm("IssueToFactory", "Bom", FormMethod.Post, new { @class = "d-inline" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@po.Id" />
                                    <button type="submit" class="btn btn-xs btn-success">🏭 صرف للمصنع</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
