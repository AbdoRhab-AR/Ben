@model IEnumerable<KOSS.Web.Models.WorkOrder>
@{
    ViewBag.Title = "أوامر التنفيذ والتشغيل (Work Orders)";
}

<div class="page-header">
    <h2>⚙️ أوامر التنفيذ والتشغيل
        <small>(المرحلة 7: تخطيط المواد والإنتاج)</small>
    </h2>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><h4>📋 قائمة أوامر التنفيذ (@Model.Count())</h4></div>
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="thead-koss">
                <tr>
                    <th>رقم أمر التنفيذ</th>
                    <th>رقم الطلب</th>
                    <th>العميل</th>
                    <th>الأولوية</th>
                    <th>المسؤول</th>
                    <th>بنود المواد BOM</th>
                    <th>الحالة</th>
                    <th>تاريخ البدء</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">لا توجد أوامر تشغيل صادرة حتى الآن.</td></tr>
                }
                @foreach (var w in Model)
                {
                    <tr>
                        <td>
                            <a href="@Url.Action("Details", new { id = w.Id })" style="font-weight:bold; font-size:1.1em;">
                                ⚙️ @w.OrderNumber
                            </a>
                        </td>
                        <td>
                            <a href="@Url.Action("Details", "Requests", new { id = w.KitchenRequestId })">
                                📁 @(w.KitchenRequest != null ? w.KitchenRequest.RequestNumber : "-")
                            </a>
                        </td>
                        <td><strong>@(w.KitchenRequest != null && w.KitchenRequest.Customer != null ? w.KitchenRequest.Customer.Name : "-")</strong></td>
                        <td><span class="label @(w.Priority == PriorityLevel.Urgent ? "label-danger" : "label-default")">@w.Priority</span></td>
                        <td>@(w.ProductionManager != null ? w.ProductionManager.FullName : "مشرف المصنع")</td>
                        <td><span class="badge badge-info">@w.MaterialRequirements.Count صنف</span></td>
                        <td><span class="label label-primary">@w.Status</span></td>
                        <td>@(w.PlannedStartDate.HasValue ? w.PlannedStartDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                        <td>
                            <a href="@Url.Action("Details", new { id = w.Id })" class="btn btn-xs btn-primary">عرض وإدارة الـ BOM</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
