@model IEnumerable<KOSS.Web.Models.WorkOrder>
@{
    ViewData["Title"] = "أوامر التشغيل والتنفيذ (BOM)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-gears text-secondary me-2"></i> أوامر التشغيل والتنفيذ وقوائم المواد (BOM)</h3>
        <p class="text-muted mb-0">متابعة أوامر التصنيع الصادرة للمصنع واستهلاك الخامات</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم أمر التشغيل</th>
                        <th>طلب المطبخ</th>
                        <th>العميل</th>
                        <th>مدير الإنتاج</th>
                        <th>تاريخ الانتهاء المتوقع</th>
                        <th>حالة أمر التشغيل</th>
                        <th>تاريخ الإصدار</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center py-5 text-muted">لا توجد أوامر تشغيل صادرة حالياً.</td></tr>
                    }
                    @foreach (var wo in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@wo.OrderNumber</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@wo.KitchenRequestId" class="fw-bold text-decoration-none">
                                    @(wo.KitchenRequest?.RequestNumber ?? $"طلب #{wo.KitchenRequestId}")
                                </a>
                            </td>
                            <td><strong>@(wo.KitchenRequest?.Customer?.Name ?? "-")</strong></td>
                            <td>@(wo.ProductionManager?.FullName ?? "مدير المصنع")</td>
                            <td><strong>@(wo.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</strong></td>
                            <td><span class="badge bg-warning text-dark px-3 py-2">@wo.Status.ToArabic()</span></td>
                            <td class="text-muted"><small>@wo.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@wo.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-list-check me-1"></i> تفاصيل الـ BOM والتشغيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>