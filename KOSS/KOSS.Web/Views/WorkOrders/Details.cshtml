@model KOSS.Web.Models.WorkOrder
@{
    ViewBag.Title = "أمر التنفيذ - " + Model.OrderNumber;
    var items = ViewBag.ItemMasters as List<KOSS.Web.Models.ItemMaster>;
}

<div class="page-header">
    <div class="row">
        <div class="col-md-7">
            <h2>⚙️ أمر التنفيذ: <strong>@Model.OrderNumber</strong>
                <small>الطلب: <a href="@Url.Action("Details", "Requests", new { id = Model.KitchenRequestId })">@(Model.KitchenRequest != null ? Model.KitchenRequest.RequestNumber : "-")</a></small>
            </h2>
        </div>
        <div class="col-md-5 text-left">
            <span class="label label-primary" style="font-size:1.1em; padding:8px 12px;">الحالة: @Model.Status</span>
            <a href="@Url.Action("Index")" class="btn btn-default">← كافة الأوامر</a>
        </div>
    </div>
</div>

<div class="row">
    <!-- قائمة بنود المواد BOM -->
    <div class="col-md-8">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4>🔩 قائمة المواد المطلوبة للمشروع (Bill of Materials - BOM)</h4>
            </div>
            <div class="panel-body table-responsive">
                <table class="table table-striped table-bordered table-hover">
                    <thead class="thead-koss">
                        <tr>
                            <th>كود الصنف</th>
                            <th>اسم الصنف</th>
                            <th>الفئة</th>
                            <th>الوحدة</th>
                            <th>الكمية المطلوبة</th>
                            <th>المصروف</th>
                            <th>المتبقي</th>
                            <th>حالة الصرف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.MaterialRequirements.Any())
                        {
                            <tr><td colspan="8" class="text-center text-muted" style="padding:20px;">لم يتم إضافة بنود مواد لهذا الأمر بعد. استخدم النموذج أدناه لإضافة خامات الـ BOM.</td></tr>
                        }
                        @foreach (var m in Model.MaterialRequirements)
                        {
                            <tr>
                                <td><code>#@m.ItemCode</code></td>
                                <td><strong>@m.ItemName</strong></td>
                                <td>@m.Category</td>
                                <td>@m.Unit</td>
                                <td>@m.QuantityRequired</td>
                                <td class="text-success"><strong>@m.QuantityIssued</strong></td>
                                <td class="text-danger"><strong>@m.QuantityToPurchase</strong></td>
                                <td>
                                    <span class="label @(m.IsFullyIssued ? "label-success" : "label-warning")">
                                        @(m.IsFullyIssued ? "✅ مكتمل الصرف" : "⏳ جاري التجهيز")
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <!-- إضافة بند مواد للـ BOM -->
                <div class="well well-sm" style="margin-top:15px;">
                    <h5>➕ إضافة صنف إلى قائمة مواد المشروع (BOM)</h5>
                    @using (Html.BeginForm("AddMaterialRequirement", "WorkOrders", FormMethod.Post, new { @class = "form-inline" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workOrderId" value="@Model.Id" />
                        <div class="form-group">
                            <select name="itemMasterId" class="form-control" style="width:320px;" required>
                                <option value="">--- اختر الصنف من دليل المواد ---</option>
                                @if (items != null)
                                {
                                    foreach (var it in items)
                                    {
                                        <option value="@it.Id">[@it.Category] @it.Name (#@it.ItemCode) - @it.StandardCost د.ل</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <input type="number" name="quantity" class="form-control" placeholder="الكمية المطلوبة" step="0.1" min="0.1" style="width:130px;" required />
                        </div>
                        <button type="submit" class="btn btn-warning">➕ إضافة للـ BOM</button>
                    }
                </div>
            </div>
        </div>

        <!-- زر بدء التصنيع -->
        @if (Model.Status == KOSS.Web.Models.WorkOrderStatus.Planning)
        {
            <div class="panel panel-success">
                <div class="panel-body text-center">
                    <p style="font-size:1.1em;">بعد مراجعة وتحديد قائمة المواد BOM، اضغط الزر أدناه لتفعيل مرحلة التصنيع بالمصنع وتوليد مراحل التشغيل.</p>
                    @using (Html.BeginForm("StartManufacturing", "WorkOrders", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="workOrderId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success btn-lg btn-block" style="font-size:1.3em; font-weight:bold;">
                            🏭 اعتماد الخطة وبدء التصنيع بالمصنع (Start Manufacturing)
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <!-- لوحة سندات الصرف والإجراءات -->
    <div class="col-md-4">
        <!-- نموذج صرف مواد فوري -->
        <div class="panel panel-primary">
            <div class="panel-heading"><h4>📦 إصدار سند صرف مخزني فوري</h4></div>
            <div class="panel-body">
                @using (Html.BeginForm("CreateIssue", "Inventory", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="kitchenRequestId" value="@Model.KitchenRequestId" />
                    <input type="hidden" name="workOrderId" value="@Model.Id" />

                    <div class="form-group">
                        <label>المستودع المصروف منه</label>
                        @Html.DropDownList("warehouseId", (SelectList)ViewBag.Warehouses, new { @class = "form-control" })
                    </div>

                    <div class="form-group">
                        <label>الصنف المراد صرفه</label>
                        <select name="itemMasterId" class="form-control" required>
                            <option value="">--- اختر الصنف ---</option>
                            @if (items != null)
                            {
                                foreach (var it in items)
                                {
                                    <option value="@it.Id">@it.Name (#@it.ItemCode)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>الكمية المصروفة</label>
                        <input type="number" name="quantity" class="form-control" step="0.1" min="0.1" required />
                    </div>

                    <div class="form-group">
                        <label>المستلم (الفني / الفريق)</label>
                        <input type="text" name="recipientName" class="form-control" placeholder="اسم فني التجميع..." />
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">📤 اعتماد وإصدار سند الصرف</button>
                }
            </div>
        </div>

        <!-- ملخص سندات الصرف المسجلة -->
        <div class="panel panel-default">
            <div class="panel-heading"><h4>سندات الصرف الصادرة (@Model.StockIssues.Count)</h4></div>
            <div class="panel-body">
                @if (!Model.StockIssues.Any())
                {
                    <p class="text-muted">لم تصدر سندات صرف لهذا الأمر بعد.</p>
                }
                @foreach (var s in Model.StockIssues)
                {
                    <div style="border-bottom:1px solid #eee; padding:5px 0;">
                        <strong>@s.IssueNumber</strong> — @s.TotalCost.ToString("N3") د.ل<br />
                        <small class="text-muted">المستلم: @s.RecipientName | @s.IssuedAt.ToString("yyyy/MM/dd")</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
