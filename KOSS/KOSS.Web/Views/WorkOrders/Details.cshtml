@model KOSS.Web.Models.WorkOrder
@{
    ViewData["Title"] = $"أمر التشغيل: {Model.OrderNumber}";
}

<div class="card card-custom mb-4">
    <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
        <div>
            <span class="badge bg-primary fs-6 me-2">@Model.OrderNumber</span>
            <span class="badge bg-warning text-dark fs-6">@Model.Status.ToArabic()</span>
        </div>
        <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-right me-1"></i> العودة لملف المشروع
        </a>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <small class="text-muted d-block">طلب المطبخ المرتبط</small>
                <strong>@(Model.KitchenRequest?.RequestNumber ?? "-")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">العميل</small>
                <strong>@(Model.KitchenRequest?.Customer?.Name ?? "-")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">تاريخ البدء</small>
                <strong>@Model.CreatedAt.ToString("yyyy/MM/dd")</strong>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">تاريخ التسليم المتوقع من المصنع</small>
                <strong>@(Model.ExpectedEndDate?.ToString("yyyy/MM/dd") ?? "-")</strong>
            </div>
        </div>

        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-boxes-stacked me-2"></i> قائمة المواد والخامات المطلوبة (BOM)</h5>
        <div class="table-responsive mb-4">
            <table class="table table-custom table-hover align-middle">
                <thead>
                    <tr>
                        <th>الخامة / الصنف</th>
                        <th>الفئة</th>
                        <th>الكمية المطلوبة بالمشروع</th>
                        <th>التكلفة التقديرية للوحدة</th>
                        <th>إجمالي التكلفة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.MaterialRequirements == null || !Model.MaterialRequirements.Any())
                    {
                        <tr><td colspan="5" class="text-center py-4 text-muted">لا توجد خامات مسجلة في قائمة الـ BOM.</td></tr>
                    }
                    @foreach (var m in Model.MaterialRequirements)
                    {
                        <tr>
                            <td><strong>@m.ItemName</strong></td>
                            <td><span class="badge bg-light text-dark border">@m.Category</span></td>
                            <td><strong>@m.QuantityRequired @m.Unit</strong></td>
                            <td>@m.EstimatedUnitCost.ToString("N3") د.ل</td>
                            <td><strong class="text-primary">@m.TotalEstimatedCost.ToString("N3") د.ل</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h5 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-list-check me-2"></i> مراحل ومهام التصنيع والقص</h5>
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle">
                <thead>
                    <tr>
                        <th>المرحلة</th>
                        <th>الفني المسؤول</th>
                        <th>الحالة</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Tasks == null || !Model.Tasks.Any())
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">لا توجد مهام تصنيع مضافة بعد.</td></tr>
                    }
                    @foreach (var t in Model.Tasks)
                    {
                        <tr>
                            <td><strong>@t.TaskName</strong></td>
                            <td>@(t.TechnicianName ?? "فني خط الإنتاج")</td>
                            <td>
                                @if (t.Status == "Completed")
                                {
                                    <span class="badge bg-success px-3 py-2">مكتملة</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@t.Status</span>
                                }
                            </td>
                            <td>
                                @if (t.Status != "Completed")
                                {
                                    <form asp-controller="Manufacturing" asp-action="CompleteTask" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="taskId" value="@t.Id" />
                                        <input type="hidden" name="workOrderId" value="@Model.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-check me-1"></i> تأكيد إنجاز المرحلة</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>