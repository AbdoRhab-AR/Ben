@model IEnumerable<KOSS.Web.Models.User>
@{
    ViewData["Title"] = "إدارة المستخدمين والصلاحيات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-user-gear text-dark me-2"></i> إدارة المستخدمين وحسابات النظام</h3>
        <p class="text-muted mb-0">إدارة حسابات الدخول، وتوزيع الرتب والصلاحيات التنفيذية</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>اسم المستخدم / البريد</th>
                        <th>الرتبة والدور</th>
                        <th>الصلاحيات الممنوحة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">لا يوجد مستخدمين مسجلين.</td></tr>
                    }
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><strong class="text-muted font-monospace">@u.UserId</strong></td>
                            <td><strong class="text-dark">@u.FullName</strong></td>
                            <td><strong class="text-primary font-monospace">@u.Username</strong></td>
                            <td><span class="badge bg-light text-primary border fs-6">@u.Role</span></td>
                            <td>
                                @if (u.UserPermissions != null && u.UserPermissions.Any())
                                {
                                    <span class="badge bg-success">@u.UserPermissions.Count صلاحيات</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">صلاحيات الرتبة الافتراضية</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>