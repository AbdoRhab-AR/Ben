@model KOSS.Web.Models.KitchenRequest
@{
    ViewData["Title"] = "فتح طلب مطبخ جديد";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-folder-plus text-primary me-2"></i> فتح وتسجيل طلب مطبخ ومشروع جديد
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label fw-bold">العميل</label>
                        <select asp-for="CustomerId" class="form-select" required>
                            <option value="">-- اختر العميل --</option>
                            @if (ViewBag.Customers is IEnumerable<KOSS.Web.Models.Customer> customers)
                            {
                                foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name (@c.Phone)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Location" class="form-label fw-bold">موقع وعنوان تركيب المطبخ</label>
                        <input asp-for="Location" class="form-control" placeholder="المدينة، المنطقة، رقم الشارع، الفيلا..." required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="ProjectType" class="form-label fw-bold">نوع المشروع</label>
                            <select asp-for="ProjectType" class="form-select">
                                <option value="Villa">فيلا سكنية</option>
                                <option value="Apartment">شقة سكنية</option>
                                <option value="Commercial">مشروع تجاري / معرض</option>
                                <option value="Chalet">شاليه / استراحة</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LayoutType" class="form-label fw-bold">شكل وتخطيط المطبخ</label>
                            <select asp-for="LayoutType" class="form-select">
                                <option value="Straight">خطي مستقيم (Straight)</option>
                                <option value="LShaped">حرف L (L-Shaped)</option>
                                <option value="UShaped">حرف U (U-Shaped)</option>
                                <option value="Parallel">متوازي (Galley / Parallel)</option>
                                <option value="Island">مطبخ مع جزيرة وسطية (Island)</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AssignedSalesStaffId" class="form-label fw-bold">موظف المبيعات المسؤول</label>
                            <select asp-for="AssignedSalesStaffId" class="form-select">
                                <option value="">-- اختر موظف المبيعات --</option>
                                @if (ViewBag.SalesStaff is IEnumerable<KOSS.Web.Models.StaffMember> salesStaff)
                                {
                                    foreach (var s in salesStaff)
                                    {
                                        <option value="@s.Id">@s.FullName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TargetDeliveryDate" class="form-label fw-bold">الموعد المتوقع للتسليم</label>
                            <input asp-for="TargetDeliveryDate" type="date" class="form-control" value="@DateTime.Now.AddDays(45).ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">الملاحظات والاشتراطات الأولية للعميل</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="الألوان المفضلة، نوع المقابض، نوع الأسطح، الأجهزة المدمجة..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
