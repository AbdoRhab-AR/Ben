@model IEnumerable<KOSS.Web.Models.KitchenRequest>
@{
    ViewData["Title"] = "طلبات ومشاريع المطابخ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-folder-tree text-primary me-2"></i> طلبات ومشاريع المطابخ</h3>
        <p class="text-muted mb-0">إدارة دورة حياة مشاريع المطابخ (مسار العمل المعتمد الـ 24 حالة)</p>
    </div>
    <a asp-action="Create" class="btn btn-koss-primary">
        <i class="fa-solid fa-plus me-1"></i> فتح طلب مطبخ جديد
    </a>
</div>

<div class="card card-custom mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الطلب، اسم العميل، رقم الهاتف، الموقع..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">--- كافة الحالات (24 حالة) ---</option>
                    @foreach (KitchenRequestStatus st in Enum.GetValues(typeof(KitchenRequestStatus)))
                    {
                        <option value="@st" selected="@(ViewBag.Status != null && (KitchenRequestStatus)ViewBag.Status == st ? "selected" : null)">@st.ToArabic()</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4"><i class="fa-solid fa-filter me-1"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary px-3"><i class="fa-solid fa-rotate-left me-1"></i> إعادة تعيين</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم الطلب</th>
                        <th>اسم العميل</th>
                        <th>الموقع والمدينة</th>
                        <th>نوع المشروع والتخطيط</th>
                        <th>حالة المشروع الحالية</th>
                        <th>تاريخ الفتح</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد طلبات مطابخ مسجلة مطابقة للبحث.</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@r.RequestNumber</strong></td>
                            <td><strong class="text-dark">@(r.Customer != null ? r.Customer.Name : "-")</strong></td>
                            <td><span class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> @r.Location</span></td>
                            <td><span class="badge bg-light text-dark border">@r.ProjectType.ToArabic() - @r.LayoutType.ToArabic()</span></td>
                            <td><span class="badge bg-primary px-3 py-2">@r.Status.ToArabic()</span></td>
                            <td class="text-muted"><small>@r.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                    <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
