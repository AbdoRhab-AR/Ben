@model IEnumerable<KOSS.Web.Models.KitchenRequest>
@{
    ViewData["Title"] = "طلبات ومشاريع المطابخ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-folder-tree text-primary me-2"></i> طلبات ومشاريع المطابخ</h3>
        <p class="text-muted mb-0">إدارة ومتابعة مسار عمل المطابخ الـ 24 حالة (من فتح الطلب إلى التسليم والتحصيل والإغلاق)</p>
    </div>
    <a asp-action="Create" class="btn btn-koss-primary">
        <i class="fa-solid fa-plus me-1"></i> فتح طلب مطبخ جديد
    </a>
</div>

<div class="card card-custom mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الطلب، اسم العميل، الهاتف، الموقع..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="status" class="form-select">
                    <option value="">--- كافة الحالات (24 حالة) ---</option>
                    @foreach (KitchenRequestStatus st in Enum.GetValues(typeof(KitchenRequestStatus)))
                    {
                        <option value="@st" selected="@(ViewBag.Status != null && (KitchenRequestStatus)ViewBag.Status == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i> تصفية</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-left me-1"></i> إلغاء</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>الموقع</th>
                        <th>نوع المشروع</th>
                        <th>حالة المشروع (Workflow Status)</th>
                        <th>تاريخ الإنشاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد طلبات مطابقة للبحث.</td></tr>
                    }
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">@r.RequestNumber</strong></td>
                            <td><strong>@(r.Customer != null ? r.Customer.Name : "-")</strong></td>
                            <td><small>@r.Location</small></td>
                            <td><span class="badge bg-light text-dark border">@r.ProjectType - @r.LayoutType</span></td>
                            <td><span class="badge bg-primary">@r.Status</span></td>
                            <td class="text-muted"><small>@r.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
