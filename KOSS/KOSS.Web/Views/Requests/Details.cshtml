@model KOSS.Web.Models.KitchenRequest
@{
    ViewData["Title"] = $"مشروع مطبخ: {Model.RequestNumber}";
    var prof = ViewBag.Profitability as KOSS.Web.Helpers.ProjectProfitabilityReport;
    var closingCheck = ViewBag.ClosingCheck as KOSS.Web.Helpers.ProjectClosingCheckResult;
    var pricing = ViewBag.PricingSummary as KOSS.Web.Helpers.ProjectPricingSummary;
}

<!-- رأس المشروع (Project Header & Status Banner) -->
<div class="card card-custom mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color:#fff;">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-primary px-3 py-2 fs-6"><i class="fa-solid fa-folder-tree me-1"></i> @Model.RequestNumber</span>
                    <span class="badge bg-warning text-dark px-3 py-2 fs-6"><i class="fa-solid fa-signal me-1"></i> @Model.Status.ToArabic()</span>
                </div>
                <h3 class="fw-bold mb-1 mt-2 text-white">
                    <i class="fa-solid fa-user me-2 text-info"></i> @(Model.Customer != null ? Model.Customer.Name : "غير محدد")
                </h3>
                <p class="text-white-50 mb-0">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i> @Model.Location &nbsp;|&nbsp;
                    <i class="fa-solid fa-layer-group me-1 text-warning"></i> @Model.ProjectType.ToArabic() - @Model.LayoutType.ToArabic() &nbsp;|&nbsp;
                    <i class="fa-regular fa-calendar-plus me-1 text-success"></i> تم الفتح: @Model.CreatedAt.ToString("yyyy/MM/dd")
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Index" class="btn btn-outline-light rounded-pill px-3">
                    <i class="fa-solid fa-arrow-right me-1"></i> العودة للطلبات
                </a>
            </div>
        </div>

        <!-- شريط الربحية الفوري المالي -->
        @if (prof != null)
        {
            <div class="row g-2 mt-3 pt-3 border-top border-white border-opacity-10 text-center">
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">إجمالي قيمة العقد</small>
                        <strong class="fs-6 text-white">@prof.ContractRevenue.ToString("N0") د.ل</strong>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">المحصل الفعلي</small>
                        <strong class="fs-6 text-success">@prof.TotalCollected.ToString("N0") د.ل</strong>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">المتبقي للتحصيل</small>
                        <strong class="fs-6 text-warning">@prof.RemainingBalance.ToString("N0") د.ل</strong>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">تكلفة المواد والتشغيل</small>
                        <strong class="fs-6 text-danger">@prof.TotalProjectCost.ToString("N0") د.ل</strong>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">صافي الربح الفعلي</small>
                        <strong class="fs-6 @(prof.IsProfitable ? "text-success" : "text-danger")">@prof.NetProfit.ToString("N0") د.ل</strong>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="p-2 rounded bg-white bg-opacity-10">
                        <small class="text-white-50 d-block">هامش الربحية</small>
                        <strong class="fs-6 @(prof.IsProfitable ? "text-success" : "text-danger")">@prof.ProfitMarginPercentage.ToString("F1")%</strong>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- تبويبات إدارة مراحل المشروع الـ 10 -->
<div class="card card-custom">
    <div class="card-header card-header-custom p-2">
        <ul class="nav nav-pills nav-pills-custom flex-wrap" id="projectTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="tab-overview-btn" data-bs-toggle="pill" data-bs-target="#tab-overview" type="button">
                    <i class="fa-solid fa-gauge-high me-1"></i> نظرة عامة والمسار
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-boxes-btn" data-bs-toggle="pill" data-bs-target="#tab-boxes" type="button">
                    <i class="fa-solid fa-boxes-stacked me-1"></i> هندسة العِلَب وفروقات الأسعار (@(Model.CabinetUnits?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-sitevisit-btn" data-bs-toggle="pill" data-bs-target="#tab-sitevisit" type="button">
                    <i class="fa-solid fa-ruler-combined me-1"></i> 1. المعاينة والقياسات (@(Model.SiteVisits?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-designs-btn" data-bs-toggle="pill" data-bs-target="#tab-designs" type="button">
                    <i class="fa-solid fa-cubes me-1"></i> 2. التصاميم 3D (@(Model.DesignVersions?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-quotations-btn" data-bs-toggle="pill" data-bs-target="#tab-quotations" type="button">
                    <i class="fa-solid fa-file-invoice-dollar me-1"></i> 3. عروض الأسعار (@(Model.Quotations?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-contracts-btn" data-bs-toggle="pill" data-bs-target="#tab-contracts" type="button">
                    <i class="fa-solid fa-file-contract me-1"></i> 4. العقد والدفعات (@(Model.Contracts?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-workorders-btn" data-bs-toggle="pill" data-bs-target="#tab-workorders" type="button">
                    <i class="fa-solid fa-gears me-1"></i> 5. أمر التشغيل والـ BOM (@(Model.WorkOrders?.Count ?? 0))
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-quality-btn" data-bs-toggle="pill" data-bs-target="#tab-quality" type="button">
                    <i class="fa-solid fa-clipboard-check me-1"></i> 6. فحص الجودة
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-installation-btn" data-bs-toggle="pill" data-bs-target="#tab-installation" type="button">
                    <i class="fa-solid fa-truck-ramp-box me-1"></i> 7. التركيب بالموقع
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-handover-btn" data-bs-toggle="pill" data-bs-target="#tab-handover" type="button">
                    <i class="fa-solid fa-signature me-1"></i> 8. التسليم والمخالصة
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="tab-finance-btn" data-bs-toggle="pill" data-bs-target="#tab-finance" type="button">
                    <i class="fa-solid fa-chart-line me-1"></i> 9. المصروفات والتكاليف
                </button>
            </li>
        </ul>
    </div>

    <div class="card-body p-4">
        <div class="tab-content" id="projectTabsContent">
            
            <!-- 1. نظرة عامة والمسار والتحكم بالحالات -->
            <div class="tab-pane fade show active" id="tab-overview">
                <div class="row g-4">
                    <div class="col-lg-7">
                        <h5 class="fw-bold text-primary mb-3"><i class="fa-solid fa-route me-2"></i> مسار تنفيذ المشروع (24-State Workflow)</h5>
                        
                        <!-- صندوق التغيير الصارم للحالة -->
                        <div class="p-3 bg-light rounded-3 border mb-4">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-arrows-spin text-primary me-1"></i> محرك انتقال الحالات (Workflow Transition Engine)</h6>
                            <form asp-action="TransitionStatus" method="post" class="row g-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@Model.Id" />
                                <div class="col-md-5">
                                    <select name="targetStatus" class="form-select">
                                        @foreach (KitchenRequestStatus st in Enum.GetValues(typeof(KitchenRequestStatus)))
                                        {
                                            <option value="@st" selected="@(st == Model.Status ? "selected" : null)">@st.ToArabic()</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <input type="text" name="reason" class="form-control" placeholder="سبب التغيير أو توجيهات الإدارة..." />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary w-100 fw-bold">تحديث</button>
                                </div>
                            </form>
                        </div>

                        <!-- سجل التغييرات التاريخي للطلب -->
                        <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-timeline me-1"></i> سجل حركة حالات المشروع التاريخي</h6>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-sm border">
                                <thead class="table-light">
                                    <tr>
                                        <th>من حالة</th>
                                        <th>إلى حالة</th>
                                        <th>المنفذ</th>
                                        <th>البيان والملاحظات</th>
                                        <th>الوقت والتاريخ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.StatusHistories == null || !Model.StatusHistories.Any())
                                    {
                                        <tr><td colspan="5" class="text-center py-3 text-muted">لا يوجد سجل تاريخي بعد.</td></tr>
                                    }
                                    @foreach (var h in Model.StatusHistories.OrderByDescending(s => s.ChangedAt))
                                    {
                                        <tr>
                                            <td><span class="badge bg-secondary">@h.OldStatus.ToArabic()</span></td>
                                            <td><span class="badge bg-primary">@h.NewStatus.ToArabic()</span></td>
                                            <td><small>@h.ChangedBy</small></td>
                                            <td><small>@h.Notes</small></td>
                                            <td class="text-muted"><small>@h.ChangedAt.ToString("yyyy/MM/dd HH:mm")</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card card-custom border-start border-primary border-4 p-3 mb-3">
                            <h6 class="fw-bold text-primary mb-2"><i class="fa-solid fa-circle-check me-1"></i> فحص شروط إغلاق المشروع الـ 9</h6>
                            @if (closingCheck != null)
                            {
                                @if (closingCheck.CanClose)
                                {
                                    <div class="alert alert-success py-2 px-3 small mb-0">
                                        <i class="fa-solid fa-check-double me-1"></i> تم استيفاء كافة شروط الإغلاق الـ 9 بالكامل، والمشروع جاهز للأرشفة النهائية.
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-warning py-2 px-3 small mb-2">
                                        <i class="fa-solid fa-clock me-1"></i> شروط غير مكتملة قبل الإغلاق:
                                    </div>
                                    <ul class="text-danger small ps-3 mb-0">
                                        @foreach (var c in closingCheck.PendingConditions)
                                        {
                                            <li>@c</li>
                                        }
                                    </ul>
                                }
                            }
                        </div>

                        <div class="card card-custom p-3">
                            <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-info-circle me-1"></i> بيانات العميل والموقع</h6>
                            <p class="mb-1"><strong>الاسم:</strong> @(Model.Customer?.Name ?? "-")</p>
                            <p class="mb-1"><strong>الهاتف:</strong> <span dir="ltr">@(Model.Customer?.Phone ?? "-")</span></p>
                            <p class="mb-1"><strong>الموقع:</strong> @Model.Location</p>
                            <p class="mb-0"><strong>ملاحظات العميل:</strong> @(string.IsNullOrEmpty(Model.Notes) ? "لا توجد ملاحظات إضافية" : Model.Notes)</p>
                        </div>
                    </div>
                </div>
            </div>


            <!-- تبويب هندسة العِلب وحاسبة فروقات الأسعار بالسوق الليبي -->
            <div class="tab-pane fade" id="tab-boxes">
                <!-- بطاقات المؤشرات السريعة للعلب والتسعير -->
                <div class="row g-3 mb-4">
                    <div class="col-md-2">
                        <div class="card card-custom p-3 text-center border-start border-primary border-4">
                            <small class="text-muted d-block">فئة العمل</small>
                            <strong class="text-dark fs-6">@Model.Category.ToArabic()</strong>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card card-custom p-3 text-center border-start border-info border-4">
                            <small class="text-muted d-block">عدد العلب المسجلة</small>
                            <strong class="text-primary fs-5">@(Model.CabinetUnits?.Count ?? 0) علبة</strong>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="card card-custom p-3 text-center border-start border-warning border-4">
                            <small class="text-muted d-block">الأمتار الطولية الإجمالية</small>
                            <strong class="text-dark fs-5">@(pricing?.TotalWidthLinearMeters.ToString("F1") ?? "0") م.ط</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-custom p-3 text-center border-start border-success border-4">
                            <small class="text-muted d-block">إجمالي سعر بيع العلب (د.ل)</small>
                            <strong class="text-success fs-5">@(pricing?.TotalModularBoxesSellingPrice.ToString("N0") ?? "0") د.ل</strong>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card card-custom p-3 text-center border-start border-secondary border-4">
                            <small class="text-muted d-block">متوسط سعر المتر الطولي المكافئ</small>
                            <strong class="text-dark fs-5">@(pricing?.RunningMeterEquivalentPrice.ToString("N0") ?? "0") د.ل / م</strong>
                        </div>
                    </div>
                </div>

                <!-- شريط الإجراءات والتحكم بالعلب -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark mb-0">
                            <i class="fa-solid fa-boxes-stacked text-primary me-2"></i> كشف العِلَب والوحدات النمطية للمشروع (Modular Cabinet Breakdown)
                        </h5>
                        <small class="text-muted">تفصيل العلب السفلية والعلوية والأبراج وحجرات الملابس وفق المعايير المعمارية بالسوق الليبي</small>
                    </div>
                    <div class="d-flex gap-2">
                        <form asp-controller="CabinetUnits" asp-action="GenerateStandardBoxes" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="requestId" value="@Model.Id" />
                            <button type="submit" class="btn btn-outline-primary btn-sm fw-bold" onclick="return confirm('هل تريد توليد باقة العلب النمطية التلقائية لهذا المشروع؟');">
                                <i class="fa-solid fa-magic-wand-sparkles me-1"></i> توليد باقة العلب النمطية تلقائياً
                            </button>
                        </form>
                        <button type="button" class="btn btn-koss-primary btn-sm fw-bold" data-bs-toggle="modal" data-bs-target="#addBoxModal">
                            <i class="fa-solid fa-plus me-1"></i> إضافة علبة / باكية جديدة
                        </button>
                    </div>
                </div>

                <!-- جدول العلب المسجلة -->
                <div class="table-responsive mb-4">
                    <table class="table table-custom table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>كود العلبة</th>
                                <th>اسم ومواصفة العلبة</th>
                                <th>الفئة</th>
                                <th>الأبعاد (عرض × ارتفاع × عمق)</th>
                                <th>خامة الكاركاس الداخلي</th>
                                <th>خامة الدرفة</th>
                                <th>الميكانيزم والإكسسوار</th>
                                <th>تكلفة التصنيع</th>
                                <th>سعر البيع</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.CabinetUnits == null || !Model.CabinetUnits.Any())
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-box-open fa-2x mb-2 d-block text-secondary opacity-50"></i>
                                        لم يتم تسجيل أي علب نمطية لهذا المشروع بعد. يمكنك النقر على زر <strong>"توليد باقة العلب النمطية تلقائياً"</strong> لإدراج كشف العلب المعتمدة آلياً.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var box in Model.CabinetUnits.OrderBy(b => b.Category).ThenBy(b => b.Id))
                                {
                                    <tr>
                                        <td><strong class="text-primary font-monospace">@box.BoxCode</strong></td>
                                        <td>
                                            <strong class="text-dark d-block">@box.Name</strong>
                                            @if (!string.IsNullOrEmpty(box.Notes))
                                            {
                                                <small class="text-muted">@box.Notes</small>
                                            }
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@box.Category.ToArabic()</span></td>
                                        <td><span dir="ltr" class="badge bg-secondary">@box.WidthCm × @box.HeightCm × @box.DepthCm سم</span></td>
                                        <td><small class="text-muted">@box.Carcass.ToArabic()</small></td>
                                        <td><small class="fw-bold text-dark">@box.DoorType.ToArabic()</small></td>
                                        <td>
                                            <small class="badge bg-info text-dark">@box.Mechanism.ToArabic()</small>
                                            @if (box.HasLedLighting)
                                            {
                                                <span class="badge bg-warning text-dark ms-1"><i class="fa-solid fa-lightbulb"></i> LED</span>
                                            }
                                            @if (box.HasGolaProfile)
                                            {
                                                <span class="badge bg-dark ms-1">Gola</span>
                                            }
                                        </td>
                                        <td><span class="text-secondary">@box.ManufacturingCost.ToString("N0") د.ل</span></td>
                                        <td><strong class="text-success">@box.SellingPrice.ToString("N0") د.ل</strong></td>
                                        <td>
                                            <form asp-controller="CabinetUnits" asp-action="DeleteBox" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@box.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="return confirm('هل أنت متأكد من حذف العلبة @box.BoxCode؟');">
                                                    <i class="fa-solid fa-trash-can"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- مصفوفة مقارنة وفروقات الأسعار بالسوق الليبي -->
                @if (pricing != null)
                {
                    <div class="card card-custom border-top border-primary border-4 p-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <h5 class="fw-bold text-dark mb-0">
                                    <i class="fa-solid fa-scale-balanced text-primary me-2"></i> مصفوفة مقارنة وفروقات الأسعار بالسوق الليبي (Price Variance Matrix)
                                </h5>
                                <p class="text-muted small mb-0">مقارنة دقيقة لتكلفة نفس المطبخ / الغرفة (مساحة: @pricing.TotalWidthLinearMeters م.ط) باختلاف خامات الواجهات، والميكانيزم، والأسطح</p>
                            </div>
                        </div>

                        <!-- 1. جدول مقارنة خامات الدرف لنفس المشروع -->
                        <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-layer-group me-1"></i> 1. فروقات خامات الدرف والواجهات لنفس المشروع (@pricing.TotalWidthLinearMeters متر طولي)</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-hover align-middle table-sm border">
                                <thead class="table-light">
                                    <tr>
                                        <th>خامة الدرفة والواجهة</th>
                                        <th>الوصف والخصائص الفنية</th>
                                        <th>التصنيف</th>
                                        <th>سعر المتر التقديري</th>
                                        <th>إجمالي تكلفة المطبخ</th>
                                        <th>الفارق عن خيار الأساس</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var v in pricing.DoorFinishVariances)
                                    {
                                        <tr>
                                            <td><strong>@v.MaterialName</strong></td>
                                            <td><small class="text-muted">@v.Description</small></td>
                                            <td><span class="badge bg-light text-dark border">@v.TierBadge</span></td>
                                            <td><strong>@v.PricePerMeter.ToString("N0") د.ل</strong></td>
                                            <td><strong class="text-primary">@v.TotalProjectEstimatedPrice.ToString("N0") د.ل</strong></td>
                                            <td>
                                                @if (v.PriceDifferenceFromBaseline > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">+@v.PriceDifferenceFromBaseline.ToString("N0") د.ل</span>
                                                }
                                                else if (v.PriceDifferenceFromBaseline < 0)
                                                {
                                                    <span class="badge bg-success">@v.PriceDifferenceFromBaseline.ToString("N0") د.ل (توفير)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">سعر الأساس</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- 2. جدول مقارنة الإكسسوارات والميكانيزم الهيدروليكي -->
                        <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-wrench me-1"></i> 2. فروقات ميكانيزم وإكسسوارات الحركة الهيدروليكية المضافة للعلب</h6>
                        <div class="table-responsive mb-4">
                            <table class="table table-hover align-middle table-sm border">
                                <thead class="table-light">
                                    <tr>
                                        <th>نوع الإكسسوار / الميكانيزم</th>
                                        <th>نطاق التطبيق في العلب</th>
                                        <th>الميزة الهندسية</th>
                                        <th>تكلفة الشراء</th>
                                        <th>سعر البيع المضاف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in pricing.HardwareVariances)
                                    {
                                        <tr>
                                            <td><strong>@m.MechanismName</strong></td>
                                            <td><small class="text-muted">@m.AppliedTo</small></td>
                                            <td><small class="text-dark">@m.Advantage</small></td>
                                            <td><span class="text-secondary">@m.UnitCost.ToString("N0") د.ل</span></td>
                                            <td><strong class="text-success">@m.SellingPrice.ToString("N0") د.ل</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- 3. جدول مقارنة أسطح العمل (الرخام والكوارتز والبورسلان) -->
                        <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-gem me-1"></i> 3. فروقات خامات أسطح العمل (الرخام والكوارتز) لنفس المطبخ</h6>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-sm border">
                                <thead class="table-light">
                                    <tr>
                                        <th>نوع سطح العمل</th>
                                        <th>الخصائص الفنية ومقاومة الحرارة والخدش</th>
                                        <th>التصنيف</th>
                                        <th>سعر المتر الطولي</th>
                                        <th>إجمالي تكلفة السطح</th>
                                        <th>الفارق المالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in pricing.CountertopVariances)
                                    {
                                        <tr>
                                            <td><strong>@c.MaterialName</strong></td>
                                            <td><small class="text-muted">@c.Description</small></td>
                                            <td><span class="badge bg-light text-dark border">@c.TierBadge</span></td>
                                            <td><strong>@c.PricePerMeter.ToString("N0") د.ل</strong></td>
                                            <td><strong class="text-primary">@c.TotalProjectEstimatedPrice.ToString("N0") د.ل</strong></td>
                                            <td>
                                                @if (c.PriceDifferenceFromBaseline > 0)
                                                {
                                                    <span class="badge bg-warning text-dark">+@c.PriceDifferenceFromBaseline.ToString("N0") د.ل</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">سعر الأساس</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>

            <!-- 2. المعاينة والقياسات -->
            <div class="tab-pane fade" id="tab-sitevisit">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-ruler-combined text-primary me-2"></i> تقارير المعاينات الميدانية والقياسات بالليزر</h5>
                    <a asp-controller="SiteVisits" asp-action="Schedule" asp-route-requestId="@Model.Id" class="btn btn-sm btn-koss-primary">
                        <i class="fa-solid fa-plus me-1"></i> جدولة موعد معاينة جديد
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>تاريخ الزيارة</th>
                                <th>المهندس المساح</th>
                                <th>الأبعاد (سم)</th>
                                <th>المساحة التقديرية</th>
                                <th>تقرير التغذية المائية والكهربائية</th>
                                <th>الحالة</th>
                                <th>الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.SiteVisits == null || !Model.SiteVisits.Any())
                            {
                                <tr><td colspan="8" class="text-center py-4 text-muted">لا توجد مواعيد معاينة مجدولة لهذا المشروع بعد.</td></tr>
                            }
                            @foreach (var v in Model.SiteVisits)
                            {
                                <tr>
                                    <td>@v.Id</td>
                                    <td><strong>@v.ScheduledDate.ToString("yyyy/MM/dd")</strong></td>
                                    <td>@(v.AssignedSurveyor != null ? v.AssignedSurveyor.FullName : "مهندس المساحة")</td>
                                    <td>@v.WallLength1Cm × @v.WallLength2Cm × @v.CeilingHeightCm سم</td>
                                    <td><span class="badge bg-light text-dark border">@v.EstimatedAreaM2 م²</span></td>
                                    <td><small class="text-muted">@(v.PlumbingNotes ?? "-") / @(v.ElectricalNotes ?? "-")</small></td>
                                    <td><span class="badge bg-primary">@v.Status.ToArabic()</span></td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-controller="SiteVisits" asp-action="RecordMeasurements" asp-route-id="@v.Id" class="btn btn-outline-primary">
                                                <i class="fa-solid fa-pen-ruler me-1"></i> إدخال القياسات
                                            </a>
                                            @if (v.Status == SiteVisitStatus.AwaitingReview)
                                            {
                                                <form asp-controller="SiteVisits" asp-action="Approve" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="visitId" value="@v.Id" />
                                                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-check"></i> اعتماد</button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. التصاميم 3D -->
            <div class="tab-pane fade" id="tab-designs">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-cubes text-primary me-2"></i> إصدارات المخططات وتصاميم 3D</h5>
                    <a asp-controller="Designs" asp-action="CreateVersion" asp-route-requestId="@Model.Id" class="btn btn-sm btn-koss-primary">
                        <i class="fa-solid fa-plus me-1"></i> رفع إصدار تصميم جديد
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>الإصدار</th>
                                <th>المصمم الداخلي</th>
                                <th>البرنامج المستخدم</th>
                                <th>الأمتار الطولية</th>
                                <th>حالة التصميم</th>
                                <th>ملاحظات واعتماد العميل</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.DesignVersions == null || !Model.DesignVersions.Any())
                            {
                                <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد تصاميم مرفوعة لهذا الطلب بعد.</td></tr>
                            }
                            @foreach (var d in Model.DesignVersions)
                            {
                                <tr>
                                    <td><strong class="text-primary">@d.VersionCode</strong></td>
                                    <td>@(d.Designer?.FullName ?? "المصمم الداخلي")</td>
                                    <td><span class="badge bg-light text-dark border">@d.SoftwareUsed</span></td>
                                    <td><strong>@d.EstimatedLinearMeters م.ط</strong></td>
                                    <td>
                                        @if (d.Status == DesignVersionStatus.ApprovedByCustomer)
                                        {
                                            <span class="badge bg-success">معتمد رسمياً من العميل</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">@d.Status.ToArabic()</span>
                                        }
                                    </td>
                                    <td><small class="text-muted">@(d.CustomerFeedback ?? "-")</small></td>
                                    <td>
                                        @if (d.Status != DesignVersionStatus.ApprovedByCustomer)
                                        {
                                            <div class="btn-group btn-group-sm">
                                                <form asp-controller="Designs" asp-action="SendToCustomer" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="designId" value="@d.Id" />
                                                    <button type="submit" class="btn btn-outline-info"><i class="fa-solid fa-paper-plane"></i> إرسال للعميل</button>
                                                </form>
                                                <form asp-controller="Designs" asp-action="ApproveByCustomer" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="designId" value="@d.Id" />
                                                    <input type="hidden" name="feedback" value="معتمد بالكامل" />
                                                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-check-double"></i> اعتماد العميل</button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-success border"><i class="fa-solid fa-lock"></i> مقفل ومعتمد</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. عروض الأسعار -->
            <div class="tab-pane fade" id="tab-quotations">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i> عروض الأسعار والتسعير المعتمد</h5>
                    <a asp-controller="Quotations" asp-action="Create" asp-route-requestId="@Model.Id" class="btn btn-sm btn-koss-primary">
                        <i class="fa-solid fa-plus me-1"></i> تحرير عرض سعر جديد
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>رقم العرض</th>
                                <th>تاريخ الإنشاء</th>
                                <th>المجموع قبل الخصم</th>
                                <th>الخصم</th>
                                <th>الصافي النهائي</th>
                                <th>حالة العرض</th>
                                <th>الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Quotations == null || !Model.Quotations.Any())
                            {
                                <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد عروض أسعار مسجلة لهذا المشروع.</td></tr>
                            }
                            @foreach (var q in Model.Quotations)
                            {
                                <tr>
                                    <td><strong class="text-primary">@q.QuotationNumber</strong></td>
                                    <td>@q.CreatedAt.ToString("yyyy/MM/dd")</td>
                                    <td>@q.SubTotal.ToString("N3") د.ل</td>
                                    <td>@q.Discount.ToString("N3") د.ل</td>
                                    <td><strong class="text-success fs-6">@q.TotalAmount.ToString("N3") د.ل</strong></td>
                                    <td><span class="badge bg-primary">@q.Status.ToArabic()</span></td>
                                    <td>
                                        @if (q.Status != QuotationStatus.Accepted)
                                        {
                                            <form asp-controller="Quotations" asp-action="Accept" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="quotationId" value="@q.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="fa-solid fa-handshake me-1"></i> قبول العميل وتوليد العقد
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">تم القبول وتوليد العقد</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 5. العقد وجدول الدفعات -->
            <div class="tab-pane fade" id="tab-contracts">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0"><i class="fa-solid fa-file-contract text-primary me-2"></i> العقود والدفعات المالية المجدولة</h5>
                    <a asp-controller="Contracts" asp-action="Create" asp-route-requestId="@Model.Id" class="btn btn-sm btn-koss-primary">
                        <i class="fa-solid fa-plus me-1"></i> تحرير عقد رسمي
                    </a>
                </div>

                @if (Model.Contracts == null || !Model.Contracts.Any())
                {
                    <div class="text-center py-5 text-muted border rounded-3 bg-light">
                        <i class="fa-solid fa-file-contract fs-1 mb-2 d-block text-secondary"></i>
                        لم يتم توقيع أي عقد رسمي لهذا المشروع حتى الآن.
                    </div>
                }
                @foreach (var c in Model.Contracts)
                {
                    <div class="card card-custom mb-3 border">
                        <div class="card-header card-header-custom bg-light">
                            <div class="d-flex justify-content-between align-items-center w-100">
                                <div>
                                    <strong class="text-primary fs-6">العقد رقم: @c.ContractNumber</strong>
                                    <span class="badge bg-success ms-2">@c.Status.ToArabic()</span>
                                </div>
                                <div>
                                    <strong>الإجمالي: @c.TotalValue.ToString("N3") د.ل</strong> |
                                    <strong class="text-success">المحصل: @c.TotalPaid.ToString("N3") د.ل</strong> |
                                    <strong class="text-danger">المتبقي: @c.RemainingBalance.ToString("N3") د.ل</strong>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-money-bill-transfer me-1"></i> جدول استحقاق الدفعات الرباعي (Payment Milestones)</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle text-center mb-3">
                                    <thead class="table-light">
                                        <tr>
                                            <th>المرحلة</th>
                                            <th>النسبة</th>
                                            <th>المبلغ المستحق</th>
                                            <th>الموعد والشرط</th>
                                            <th>حالة السداد</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var ps in c.PaymentSchedules)
                                        {
                                            <tr>
                                                <td><strong>@ps.StageName</strong></td>
                                                <td>@ps.Percentage%</td>
                                                <td>@ps.Amount.ToString("N3") د.ل</td>
                                                <td><small class="text-muted">@(ps.Condition ?? "-")</small></td>
                                                <td>
                                                    @if (ps.IsPaid)
                                                    {
                                                        <span class="badge bg-success">تم السداد بتاريخ @(ps.PaidAt?.ToString("yyyy/MM/dd") ?? "-")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">بانتظار التحصيل</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- إيصال قبض جديد -->
                            <div class="p-3 bg-light rounded-3 border">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-receipt text-primary me-1"></i> تسجيل إيصال قبض دفعة نقدية أو مصرفية</h6>
                                <form asp-controller="Contracts" asp-action="RecordDeposit" method="post" class="row g-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="contractId" value="@c.Id" />
                                    <div class="col-md-3">
                                        <input type="number" step="0.001" name="amount" class="form-control form-control-sm" placeholder="المبلغ المقبوض (د.ل)" required />
                                    </div>
                                    <div class="col-md-3">
                                        <select name="method" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<PaymentMethod>()"></select>
                                    </div>
                                    <div class="col-md-4">
                                        <input type="text" name="referenceNumber" class="form-control form-control-sm" placeholder="رقم الشيك أو الحوالة المصرفية..." />
                                    </div>
                                    <div class="col-md-2">
                                        <button type="submit" class="btn btn-sm btn-success w-100 fw-bold">تسجيل وقبض</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 6. التشغيل والمصنع -->
            <div class="tab-pane fade" id="tab-workorders">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-gears text-primary me-2"></i> أمر التنفيذ والتشغيل وقائمة المواد (BOM)</h5>
                @if (Model.WorkOrders == null || !Model.WorkOrders.Any())
                {
                    <div class="text-center py-5 text-muted border rounded bg-light">
                        لا يوجد أمر تنفيذ صادر بعد. يتم توليده آلياً عند تفعيل العقد وقبض العربون.
                    </div>
                }
                @foreach (var wo in Model.WorkOrders)
                {
                    <div class="card card-custom mb-3 border">
                        <div class="card-header card-header-custom bg-light d-flex justify-content-between align-items-center">
                            <div>
                                <strong class="text-primary">أمر التشغيل: @wo.OrderNumber</strong>
                                <span class="badge bg-warning text-dark ms-2">@wo.Status.ToArabic()</span>
                            </div>
                            <div>
                                @if (wo.Status == WorkOrderStatus.Planning)
                                {
                                    <form asp-controller="WorkOrders" asp-action="StartProduction" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="workOrderId" value="@wo.Id" />
                                        <button type="submit" class="btn btn-sm btn-koss-primary"><i class="fa-solid fa-play me-1"></i> بدء التصنيع والقص بالمصنع</button>
                                    </form>
                                }
                            </div>
                        </div>
                        <div class="card-body p-3">
                            <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-boxes-stacked me-1"></i> متطلبات الخامات والمواد (Material Requirements / BOM)</h6>
                            <div class="table-responsive mb-3">
                                <table class="table table-sm table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>الخامة / الصنف</th>
                                            <th>الفئة</th>
                                            <th>الكمية المطلوبة</th>
                                            <th>التكلفة التقديرية</th>
                                            <th>إجمالي التكلفة</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in wo.MaterialRequirements)
                                        {
                                            <tr>
                                                <td><strong>@m.ItemName</strong></td>
                                                <td><span class="badge bg-light text-dark border">@m.Category</span></td>
                                                <td>@m.QuantityRequired @m.Unit</td>
                                                <td>@m.EstimatedUnitCost.ToString("N3") د.ل</td>
                                                <td><strong>@m.TotalEstimatedCost.ToString("N3") د.ل</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <h6 class="fw-bold text-secondary mb-2"><i class="fa-solid fa-list-check me-1"></i> خطوط ومراحل التصنيع بالمصنع</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th>المرحلة</th>
                                            <th>الفني المسؤول</th>
                                            <th>الحالة</th>
                                            <th>الإجراء</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var t in wo.Tasks)
                                        {
                                            <tr>
                                                <td><strong>@t.TaskName</strong></td>
                                                <td>@(t.TechnicianName ?? "فني خط الإنتاج")</td>
                                                <td>
                                                    @if (t.Status == "Completed")
                                                    {
                                                        <span class="badge bg-success">مكتملة</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@t.Status</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (t.Status != "Completed")
                                                    {
                                                        <form asp-controller="Manufacturing" asp-action="CompleteTask" method="post" class="d-inline">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="taskId" value="@t.Id" />
                                                            <input type="hidden" name="workOrderId" value="@wo.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="fa-solid fa-check"></i> تأكيد الإنجاز</button>
                                                        </form>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- 7. فحص الجودة والمطابقة -->
            <div class="tab-pane fade" id="tab-quality">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-clipboard-check text-primary me-2"></i> فحص الجودة والمطابقة الفنية بالمصنع</h5>
                @{
                    var activeWo = Model.WorkOrders?.FirstOrDefault();
                }
                @if (activeWo != null)
                {
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-stamp text-success me-1"></i> تسجيل تقرير فحص ومطابقة جديد</h6>
                        <form asp-controller="Manufacturing" asp-action="PerformQualityCheck" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="workOrderId" value="@activeWo.Id" />
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">نتيجة الفحص الفني</label>
                                    <select name="isPassed" class="form-select">
                                        <option value="true">اجتاز الفحص بنجاح ومطابق للمواصفات (جاهز للتركيب)</option>
                                        <option value="false">توجد ملاحظات ونواقص تحتاج معالجة بالمصنع</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">ملاحظات الفحص</label>
                                    <input type="text" name="notes" class="form-control" placeholder="تقرير فحص الأبعاد والأسطح والمفصلات..." />
                                </div>
                            </div>
                            <button type="submit" class="btn btn-koss-primary px-4"><i class="fa-solid fa-check me-1"></i> اعتماد التقرير</button>
                        </form>
                    </div>
                }
            </div>

            <!-- 8. التركيب الميداني -->
            <div class="tab-pane fade" id="tab-installation">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-truck-ramp-box text-primary me-2"></i> أوامر التركيب الميداني وجدولة الموقع</h5>
                @if (activeWo != null)
                {
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-calendar-plus text-primary me-1"></i> جدولة موعد تركيب جديد</h6>
                        <form asp-controller="Installation" asp-action="Schedule" method="post" class="row g-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="workOrderId" value="@activeWo.Id" />
                            <div class="col-md-4">
                                <label class="form-label fw-bold">تاريخ التركيب</label>
                                <input type="date" name="scheduledDate" class="form-control" value="@DateTime.Now.AddDays(2).ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">رئيس فريق التركيب</label>
                                <input type="text" name="teamLeadName" class="form-control" placeholder="اسم الفني المسؤول" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-bold">الشاحنة / وسيلة النقل</label>
                                <input type="text" name="vehicleNumber" class="form-control" placeholder="رقم الشاحنة" />
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-koss-primary px-4"><i class="fa-solid fa-calendar-check me-1"></i> جدولة التركيب</button>
                            </div>
                        </form>
                    </div>
                }
            </div>

            <!-- 9. التسليم النهائي -->
            <div class="tab-pane fade" id="tab-handover">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-signature text-primary me-2"></i> محضر التسليم النهائي وتوقيع العميل</h5>
                @if (activeWo != null)
                {
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-pen-nib text-success me-1"></i> تحرير واعتماد محضر التسليم والمخالصة الفنية</h6>
                        <form asp-controller="Installation" asp-action="CompleteHandover" method="post" class="row g-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="workOrderId" value="@activeWo.Id" />
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اسم المستلم</label>
                                <input type="text" name="customerSignerName" class="form-control" value="@(Model.Customer?.Name ?? "")" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">قبول واستلام العميل</label>
                                <select name="customerAccepted" class="form-select">
                                    <option value="true">تم قبول واستلام المطبخ مطابقاً للعقد 100%</option>
                                    <option value="false">يوجد تحفظ وملاحظات غير مكتملة</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold">ملاحظات محضر التسليم</label>
                                <textarea name="clientNotes" class="form-control" rows="2" placeholder="ملاحظات العميل الختامية..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-success px-4 fw-bold"><i class="fa-solid fa-file-signature me-1"></i> توقيع واعتماد محضر التسليم</button>
                            </div>
                        </form>
                    </div>
                }
            </div>

            <!-- 10. التكاليف والربحية والمصروفات -->
            <div class="tab-pane fade" id="tab-finance">
                <h5 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-line text-primary me-2"></i> مركز تكلفة المشروع والمصروفات المباشرة</h5>
                
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-plus-circle text-danger me-1"></i> قيد مصروف مباشر على المشروع (نقل، رافعة، تركيب إضافي...)</h6>
                    <form asp-action="AddExpense" method="post" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="kitchenRequestId" value="@Model.Id" />
                        <div class="col-md-3">
                            <input type="text" name="expenseType" class="form-control form-control-sm" placeholder="نوع المصروف (شحن، رافعة...)" required />
                        </div>
                        <div class="col-md-3">
                            <input type="number" step="0.001" name="amount" class="form-control form-control-sm" placeholder="المبلغ (د.ل)" required />
                        </div>
                        <div class="col-md-2">
                            <input type="text" name="invoiceNumber" class="form-control form-control-sm" placeholder="رقم الإيصال" />
                        </div>
                        <div class="col-md-3">
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="البيان والتفاصيل" />
                        </div>
                        <div class="col-md-1">
                            <button type="submit" class="btn btn-sm btn-danger w-100 fw-bold">قيد</button>
                        </div>
                    </form>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>نوع المصروف</th>
                                <th>المبلغ (د.ل)</th>
                                <th>رقم الفاتورة / الإيصال</th>
                                <th>البيان</th>
                                <th>التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Expenses == null || !Model.Expenses.Any())
                            {
                                <tr><td colspan="5" class="text-center py-3 text-muted">لا توجد مصروفات إضافية مقيدة على هذا المشروع.</td></tr>
                            }
                            @foreach (var e in Model.Expenses)
                            {
                                <tr>
                                    <td><strong>@e.ExpenseType</strong></td>
                                    <td><strong class="text-danger">@e.Amount.ToString("N3") د.ل</strong></td>
                                    <td><small class="badge bg-light text-dark border">@(e.ReceiptReference ?? "-")</small></td>
                                    <td><small>@(e.Description ?? "-")</small></td>
                                    <td class="text-muted"><small>@e.ExpenseDate.ToString("yyyy/MM/dd")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- مودال إضافة علبة نمطية جديدة لمشروع -->
<div class="modal fade" id="addBoxModal" tabindex="-1" aria-labelledby="addBoxModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark" id="addBoxModalLabel">
                    <i class="fa-solid fa-box-open text-primary me-2"></i> إضافة علبة / باكية نمطية جديدة
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="CabinetUnits" asp-action="AddBox" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="KitchenRequestId" value="@Model.Id" />

                <div class="modal-body p-4">
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">فئة ونوع العلبة</label>
                            <select name="Category" class="form-select" required>
                                <optgroup label="عِلب المطابخ السفلية والعلوية">
                                    <option value="BaseCabinet">علبة سفلية - مطبخ (Base Unit)</option>
                                    <option value="WallCabinet">علبة علوية - مطبخ (Wall Unit)</option>
                                    <option value="TallCabinet">برج طولي - أفران وبانتري (Tall Tower)</option>
                                    <option value="IslandCabinet">علبة جزيرة وسطية (Island)</option>
                                    <option value="LoftCabinet">علبة سقفية علوية (Loft Unit)</option>
                                </optgroup>
                                <optgroup label="باكيات وعِلب حجرات الملابس (Dressing Rooms)">
                                    <option value="DressingLongHang">باكية تعليق طويل - عبايات وفساتين</option>
                                    <option value="DressingShortHang">باكية تعليق قصير - بدل وقمصان</option>
                                    <option value="DressingDrawersAndJewelry">باكية أدراج وساعات ومجوهرات</option>
                                    <option value="DressingShelvesAndShoes">باكية أرفف ملابس وأحذية</option>
                                    <option value="DressingIsland">جزيرة دريسنج روم وسطية</option>
                                </optgroup>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">كود العلبة</label>
                            <input type="text" name="BoxCode" class="form-control font-monospace" placeholder="B-SINK-90" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">العرض (سم)</label>
                            <input type="number" step="1" name="WidthCm" class="form-control" value="60" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">اسم العلبة ومواصفاتها</label>
                            <input type="text" name="Name" class="form-control" placeholder="مثال: علبة حوض معزولة ضد الماء" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">الارتفاع (سم)</label>
                            <input type="number" step="1" name="HeightCm" class="form-control" value="85" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">العمق (سم)</label>
                            <input type="number" step="1" name="DepthCm" class="form-control" value="60" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">خامة الكاركاس الداخلي</label>
                            <select name="Carcass" class="form-select">
                                <option value="WhiteMelamineMdf">MDF أبيض تركي مكسو ميلامين</option>
                                <option value="MoistureResistantGreenHmr">MDF أخضر مقاوم للرطوبة HMR</option>
                                <option value="MarinePlywoodUnderSink">كونتر Plywood معزول (للحوض)</option>
                                <option value="Chipboard">خشب حبيبي معالج اقتصادي</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">خامة الواجهة والدرفة</label>
                            <select name="DoorType" class="form-select">
                                <option value="HighGlossAcrylic">أكريليك عالي اللمعان (Acrylic)</option>
                                <option value="PolylacSuperMatt">بولي لاك وسوبر مات حراري</option>
                                <option value="MelamineFormica">ميلامين / فورميكا اقتصادي</option>
                                <option value="AluminiumFrameGlass">زجاج سموكي بإطار ألمنيوم</option>
                                <option value="OpenWalkInNoDoors">مفتوحة بدون درف (Walk-in)</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">الميكانيزم والإكسسوار</label>
                            <select name="Mechanism" class="form-select">
                                <option value="BlumSoftCloseHinges">مفصلات بلوم هيدروليك Soft-Close</option>
                                <option value="StandardHinges">مفصلات عادية</option>
                                <option value="BlumAventosDoubleLift">رافعة Aventos HF/HK مزدوجة</option>
                                <option value="MagicCornerOrLeMans">سلة زاوية ذكية (Magic Corner)</option>
                                <option value="TandemBoxDrawers">أدراج تاندم بوكس هيدروليك</option>
                                <option value="VelvetJewelryOrganizer">منظم ساعات ومجوهرات مخمل</option>
                                <option value="PullOutTrouserRack">علاقة بناطيل سحب</option>
                                <option value="SpiceRackPullOut">سلة سحب بهارات وزيوت</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="form-check p-2 rounded bg-light border">
                                <input class="form-check-input ms-2" type="checkbox" name="HasLedLighting" value="true" id="chkLed" />
                                <label class="form-check-label fw-bold" for="chkLed">إنارة LED مخفية مدمجة بالعلبة</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check p-2 rounded bg-light border">
                                <input class="form-check-input ms-2" type="checkbox" name="HasGolaProfile" value="true" id="chkGola" checked />
                                <label class="form-check-label fw-bold" for="chkGola">بروفايل ألمنيوم غولا (فتح بدون مقبض)</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-bold">ملاحظات التصنيع والتركيب</label>
                        <textarea name="Notes" class="form-control" rows="2" placeholder="ملاحظات حول أبعاد خاصة، تفريغ سباكة، أو حفر CNC..."></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-koss-primary px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i> إضافة واحتساب السعر تلقائياً
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var urlParams = new URLSearchParams(window.location.search);
        var activeTab = urlParams.get('tab');
        if (activeTab === 'boxes') {
            var tabTrigger = document.querySelector('#tab-boxes-btn');
            if (tabTrigger) {
                var tab = new bootstrap.Tab(tabTrigger);
                tab.show();
            }
        }
    });
</script>
