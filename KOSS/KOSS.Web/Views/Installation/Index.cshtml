@model IEnumerable<KOSS.Web.Models.InstallationOrder>
@{
    ViewBag.Title = "إدارة التركيبات الميدانية والتسليم";
}

<div class="page-header">
    <h2>🚚 إدارة التركيبات الميدانية ومحاضر التسليم
        <small>(المرحلة 14 و 15: إتمام التركيب وتوقيع محضر الاستلام)</small>
    </h2>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><h4>📋 قائمة أوامر التركيب المجدولة والمنجزة (@Model.Count())</h4></div>
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="thead-koss">
                <tr>
                    <th>رقم أمر التركيب</th>
                    <th>رقم الطلب</th>
                    <th>العميل</th>
                    <th>الموقع</th>
                    <th>الموعد المجدول</th>
                    <th>رئيس الفريق</th>
                    <th>الأمتار المنجزة</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">لا توجد عمليات تركيب مجدولة حالياً.</td></tr>
                }
                @foreach (var i in Model)
                {
                    var wo = i.WorkOrder;
                    var req = wo != null ? wo.KitchenRequest : null;
                    <tr>
                        <td><strong>@i.OrderNumber</strong></td>
                        <td>
                            <a href="@Url.Action("Details", "Requests", new { id = req != null ? req.Id : 0 })" style="font-weight:bold;">
                                📁 @(req != null ? req.RequestNumber : "-")
                            </a>
                        </td>
                        <td><strong>@(req != null && req.Customer != null ? req.Customer.Name : "-")</strong></td>
                        <td><small>@(req != null ? req.Location : "-")</small></td>
                        <td>@i.ScheduledDate.ToString("yyyy/MM/dd")</td>
                        <td>@i.TeamLeadName</td>
                        <td>@i.InstalledLinearMeters م</td>
                        <td><span class="label @(i.Status == "FullyCompleted" ? "label-success" : "label-primary")">@i.Status</span></td>
                        <td>
                            @if (i.Status == "Scheduled")
                            {
                                using (Html.BeginForm("StartInstallation", "Installation", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="installationOrderId" value="@i.Id" />
                                    <button type="submit" class="btn btn-xs btn-warning">🚚 بدء التركيب الميداني</button>
                                }
                            }
                            else if (i.Status == "InProgress")
                            {
                                <button type="button" class="btn btn-xs btn-success" data-toggle="modal" data-target="#handoverModal-@i.Id">
                                    🏁 تحرير محضر التسليم
                                </button>

                                <!-- نافذة محضر التسليم المنبثقة -->
                                <div class="modal fade" id="handoverModal-@i.Id" tabindex="-1" role="dialog">
                                    <div class="modal-dialog" role="document">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                                <h4 class="modal-title">🎉 تحرير محضر التسليم النهائي واستلام العميل</h4>
                                            </div>
                                            @using (Html.BeginForm("CompleteHandover", "Installation", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="workOrderId" value="@i.WorkOrderId" />
                                                <div class="modal-body">
                                                    <div class="form-group">
                                                        <label>اسم العميل المستلم</label>
                                                        <input type="text" name="customerSignerName" class="form-control" value="@(req != null && req.Customer != null ? req.Customer.Name : "")" required />
                                                    </div>
                                                    <div class="form-group">
                                                        <label>الأمتار الطولية المنجزة</label>
                                                        <input type="number" name="installedLinearMeters" class="form-control" value="10" step="0.1" required />
                                                    </div>
                                                    <div class="form-group">
                                                        <label>ملاحظات العميل الختامية</label>
                                                        <textarea name="customerRemarks" class="form-control" rows="3" placeholder="ملاحظات العميل عند الفحص والاستلام..."></textarea>
                                                    </div>
                                                    <div class="checkbox">
                                                        <label>
                                                            <input type="checkbox" name="customerAccepted" value="true" checked /> العميل موافق ومستلم لكافة الأعمال حسب المواصفات
                                                        </label>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-default" data-dismiss="modal">إلغاء</button>
                                                    <button type="submit" class="btn btn-success">✅ اعتماد محضر التسليم الرسمي</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <span class="text-success">✅ تم التسليم</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
