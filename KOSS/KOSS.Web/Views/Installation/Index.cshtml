@model IEnumerable<KOSS.Web.Models.InstallationOrder>
@{
    ViewData["Title"] = "إدارة التركيبات الميدانية بالموقع";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-truck-ramp-box text-warning me-2"></i> إدارة وجدولة التركيبات الميدانية</h3>
        <p class="text-muted mb-0">متابعة مواعيد التوصيل، وفِرق الفنيين، وتوقيع محاضر الاستلام والتسليم</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>أمر التركيب</th>
                        <th>طلب المطبخ</th>
                        <th>اسم العميل والموقع</th>
                        <th>تاريخ التركيب</th>
                        <th>رئيس فريق التركيب</th>
                        <th>حالة التركيب</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد أوامر تركيب مجدولة حالياً.</td></tr>
                    }
                    @foreach (var order in Model)
                    {
                        var req = order.WorkOrder?.KitchenRequest;
                        <tr>
                            <td><strong class="text-primary font-monospace">@order.OrderNumber</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@(req?.Id ?? 0)" class="fw-bold text-decoration-none">
                                    @(req?.RequestNumber ?? $"طلب #{order.WorkOrderId}")
                                </a>
                            </td>
                            <td>
                                <strong>@(req?.Customer?.Name ?? "-")</strong>
                                <small class="text-muted d-block">@(req?.Location ?? "-")</small>
                            </td>
                            <td><strong class="text-dark">@order.ScheduledDate.ToString("yyyy/MM/dd")</strong></td>
                            <td><span class="badge bg-light text-dark border">@order.TeamLeadName</span></td>
                            <td><span class="badge bg-primary px-3 py-2">@order.Status</span></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@(req?.Id ?? 0)" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-signature me-1"></i> محضر التسليم
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
