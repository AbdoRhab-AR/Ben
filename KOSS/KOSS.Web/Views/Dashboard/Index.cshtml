@model KOSS.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "لوحة التحكم الرئيسية للمنظومة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1"><i class="fa-solid fa-chart-pie text-primary me-2"></i> لوحة التحكم والمؤشرات الحية</h2>
        <p class="text-muted mb-0">نظرة شاملة على مسار عمل تصنيع المطابخ والإنتاج والمالية</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Requests" asp-action="Create" class="btn btn-koss-primary">
            <i class="fa-solid fa-plus me-1"></i> فتح طلب مطبخ جديد
        </a>
        <a asp-controller="Inquiries" asp-action="Create" class="btn btn-outline-secondary">
            <i class="fa-solid fa-headset me-1"></i> تسجيل استفسار
        </a>
    </div>
</div>

<!-- إحصائيات الإيرادات والأداء -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted fw-bold small">إجمالي قيمة العقود النشطة</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalContractValue.ToString("N0") <small class="fs-6">د.ل</small></h3>
                </div>
                <div class="bg-primary bg-opacity-10 p-3 rounded-circle text-primary">
                    <i class="fa-solid fa-file-invoice-dollar fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted fw-bold small">إجمالي المقبوضات المحصلة</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.TotalCollected.ToString("N0") <small class="fs-6">د.ل</small></h3>
                </div>
                <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                    <i class="fa-solid fa-hand-holding-dollar fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted fw-bold small">مشاريع قيد التصنيع والقص</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.ActiveWorkOrders <small class="fs-6">مشروع</small></h3>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="fa-solid fa-industry fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-info border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted fw-bold small">مشاريع في مرحلة التركيب</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.InInstallation <small class="fs-6">مطبخ</small></h3>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="fa-solid fa-truck-fast fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مسار العمل الحي (ERP Pipeline Stats) -->
<div class="card card-custom mb-4">
    <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-bars-progress text-primary me-2"></i> مؤشرات مراحل العمل الحالية (24-State Workflow)</span>
    </div>
    <div class="card-body">
        <div class="row g-2 text-center">
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">استفسارات جارية</small>
                    <strong class="fs-5 text-dark">@Model.ActiveInquiries</strong>
                </div>
            </div>
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">معاينات مجدولة</small>
                    <strong class="fs-5 text-primary">@Model.ScheduledSiteVisits</strong>
                </div>
            </div>
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">تصاميم 3D جارية</small>
                    <strong class="fs-5 text-warning">@Model.ActiveDesigns</strong>
                </div>
            </div>
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">عروض تنتظر الرد</small>
                    <strong class="fs-5 text-info">@Model.PendingQuotations</strong>
                </div>
            </div>
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">عقود نشطة</small>
                    <strong class="fs-5 text-success">@Model.ActiveContracts</strong>
                </div>
            </div>
            <div class="col">
                <div class="p-2 border rounded bg-light">
                    <small class="text-muted d-block">جاهز للتركيب</small>
                    <strong class="fs-5 text-primary">@Model.ReadyForInstallation</strong>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- جدول أحدث الطلبات والمشاريع -->
<div class="card card-custom">
    <div class="card-header card-header-custom d-flex justify-content-between align-items-center">
        <span><i class="fa-solid fa-clock-rotate-left text-primary me-2"></i> أحدث طلبات ومشاريع المطابخ</span>
        <a asp-controller="Requests" asp-action="Index" class="btn btn-sm btn-outline-primary">عرض كافة الطلبات</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>رقم الطلب</th>
                        <th>العميل</th>
                        <th>الموقع</th>
                        <th>نوع المشروع والتخطيط</th>
                        <th>الحالة الراهنة</th>
                        <th>تاريخ الإنشاء</th>
                        <th>الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentRequests == null || !Model.RecentRequests.Any())
                    {
                        <tr><td colspan="7" class="text-center py-4 text-muted">لا توجد طلبات مطابخ مسجلة حالياً.</td></tr>
                    }
                    else
                    {
                        foreach (var req in Model.RecentRequests)
                        {
                            <tr>
                                <td><strong class="text-primary font-monospace">@req.RequestNumber</strong></td>
                                <td><strong>@(req.Customer != null ? req.Customer.Name : "-")</strong></td>
                                <td><small class="text-muted"><i class="fa-solid fa-location-dot text-danger me-1"></i> @req.Location</small></td>
                                <td><span class="badge bg-light text-dark border">@req.ProjectType.ToArabic() - @req.LayoutType.ToArabic()</span></td>
                                <td><span class="badge bg-primary px-3 py-2">@req.Status.ToArabic()</span></td>
                                <td class="text-muted"><small>@req.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                                <td>
                                    <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id" class="btn btn-sm btn-outline-primary fw-bold">
                                        <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>