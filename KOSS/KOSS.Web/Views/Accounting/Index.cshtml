@model IEnumerable<KOSS.Web.Helpers.ProjectProfitabilityReport>
@{
    ViewData["Title"] = "التحليل المالي وتكاليف المشاريع والربحية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-scale-balanced text-primary me-2"></i> التحليل المالي وتكاليف المشاريع والربحية</h3>
        <p class="text-muted mb-0">مراقبة إيرادات العقود، والمصروفات المباشرة، وتكلفة المواد، وصافي هوامش الربح</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم المشروع</th>
                        <th>اسم العميل</th>
                        <th>إجمالي إيراد العقد</th>
                        <th>المحصل الفعلي</th>
                        <th>المتبقي للتحصيل</th>
                        <th>تكلفة المواد والمصروفات</th>
                        <th>صافي الربح</th>
                        <th>هامش الربح</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted">لا توجد مشاريع لتحليل بياناتها المالية حالياً.</td></tr>
                    }
                    @foreach (var prof in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@prof.RequestNumber</strong></td>
                            <td><strong class="text-dark">@prof.CustomerName</strong></td>
                            <td><strong>@prof.ContractRevenue.ToString("N0") د.ل</strong></td>
                            <td><strong class="text-success">@prof.TotalCollected.ToString("N0") د.ل</strong></td>
                            <td><strong class="text-danger">@prof.RemainingBalance.ToString("N0") د.ل</strong></td>
                            <td><strong class="text-warning">@prof.TotalProjectCost.ToString("N0") د.ل</strong></td>
                            <td><strong class="@(prof.IsProfitable ? "text-success" : "text-danger")">@prof.NetProfit.ToString("N0") د.ل</strong></td>
                            <td><span class="badge @(prof.IsProfitable ? "bg-success" : "bg-danger") px-3 py-2">@prof.ProfitMarginPercentage.ToString("F1")%</span></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@prof.KitchenRequestId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-chart-line me-1"></i> تقرير التكاليف
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
