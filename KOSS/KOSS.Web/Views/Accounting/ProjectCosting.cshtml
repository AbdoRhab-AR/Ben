@model KOSS.Web.Helpers.ProjectProfitabilityReport
@{
    ViewData["Title"] = $"تقرير ربحية وتكاليف المشروع: {Model.RequestNumber}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-chart-pie text-primary me-2"></i> تقرير التكاليف والربحية الفعلي: @Model.RequestNumber</h3>
        <p class="text-muted mb-0">التحليل المالي الدقيق لإيرادات وتكاليف وهوامش ربح مشروع المطبخ</p>
    </div>
    <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة لملف المشروع
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-primary border-4">
            <span class="text-muted small fw-bold">إجمالي إيراد العقد</span>
            <h4 class="fw-bold text-primary mb-0 mt-1">@Model.ContractRevenue.ToString("N3") د.ل</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-success border-4">
            <span class="text-muted small fw-bold">إجمالي المقبوضات الفعلية</span>
            <h4 class="fw-bold text-success mb-0 mt-1">@Model.TotalCollected.ToString("N3") د.ل</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start border-danger border-4">
            <span class="text-muted small fw-bold">إجمالي تكلفة المواد والمصروفات</span>
            <h4 class="fw-bold text-danger mb-0 mt-1">@Model.TotalProjectCost.ToString("N3") د.ل</h4>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-custom p-3 border-start @(Model.IsProfitable ? "border-success" : "border-danger") border-4">
            <span class="text-muted small fw-bold">صافي الربح الفعلي (هامش @Model.ProfitMarginPercentage.ToString("F1")%)</span>
            <h4 class="fw-bold @(Model.IsProfitable ? "text-success" : "text-danger") mb-0 mt-1">@Model.NetProfit.ToString("N3") د.ل</h4>
        </div>
    </div>
</div>