@model IEnumerable<KOSS.Web.Models.Quotation>
@{
    ViewData["Title"] = "عروض الأسعار والتسعير";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i> عروض الأسعار والتسعير المعتمد</h3>
        <p class="text-muted mb-0">تحرير ومراجعة عروض الأسعار والتفاوض مع العملاء</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم العرض</th>
                        <th>طلب المطبخ</th>
                        <th>العميل</th>
                        <th>المجموع قبل الخصم</th>
                        <th>الخصم</th>
                        <th>الصافي النهائي</th>
                        <th>حالة العرض</th>
                        <th>تاريخ الإنشاء</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted">لا توجد عروض أسعار مسجلة.</td></tr>
                    }
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@q.QuotationNumber</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@q.KitchenRequestId" class="fw-bold text-decoration-none">
                                    @(q.KitchenRequest?.RequestNumber ?? $"طلب #{q.KitchenRequestId}")
                                </a>
                            </td>
                            <td><strong>@(q.KitchenRequest?.Customer?.Name ?? "-")</strong></td>
                            <td>@q.SubTotal.ToString("N3") د.ل</td>
                            <td>@q.Discount.ToString("N3") د.ل</td>
                            <td><strong class="text-success fs-6">@q.TotalAmount.ToString("N3") د.ل</strong></td>
                            <td><span class="badge bg-primary px-3 py-2">@q.Status.ToArabic()</span></td>
                            <td class="text-muted"><small>@q.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                @if (q.Status != QuotationStatus.Accepted)
                                {
                                    <form asp-action="Accept" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="quotationId" value="@q.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fa-solid fa-handshake me-1"></i> قبول وتوليد عقد
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border"><i class="fa-solid fa-file-contract me-1"></i> تم التعاقد</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>