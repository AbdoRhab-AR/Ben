@model KOSS.Web.Models.Quotation
@{
    ViewData["Title"] = "تحرير عرض سعر رسمي للمشروع";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i> تحرير عرض سعر وتسعير رسمي لطلب المطبخ
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KitchenRequestId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="DesignVersionId" class="form-label fw-bold">إصدار التصميم المعتمد للتسعير</label>
                            <select asp-for="DesignVersionId" class="form-select" asp-items="ViewBag.DesignVersions">
                                <option value="">-- اختر التصميم المرتبط --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ValidityDays" class="form-label fw-bold">صلاحية العرض (أيام)</label>
                            <input asp-for="ValidityDays" type="number" class="form-control" value="15" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SubTotal" class="form-label fw-bold">المجموع الإجمالي قبل الخصم (د.ل)</label>
                            <input asp-for="SubTotal" type="number" step="0.001" class="form-control" placeholder="0.000" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Discount" class="form-label fw-bold">قيمة الخصم التجاري الممنوح (د.ل)</label>
                            <input asp-for="Discount" type="number" step="0.001" class="form-control" value="0.000" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PaymentTerms" class="form-label fw-bold">شروط وجدول الدفعات المقترح</label>
                        <textarea asp-for="PaymentTerms" class="form-control" rows="2">30% عربون عند التعاقد، 40% عند بدء التصنيع والقص بالمصنع، 20% عند الجاهزية للتركيب، 10% عند التسليم النهائي وتوقيع المحضر.</textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات ومواصفات العرض الخاصة</label>
                        <textarea asp-for="Notes" class="form-control" rows="2" placeholder="نوع الخشب، نوع الرخام، ماركة الإكسسوارات والمفصلات..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-check me-1"></i> حفظ وإصدار عرض السعر
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>