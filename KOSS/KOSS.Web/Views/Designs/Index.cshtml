@model IEnumerable<KOSS.Web.Models.DesignVersion>
@{
    ViewData["Title"] = "إصدارات ومخططات التصاميم 3D";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-cubes text-info me-2"></i> إصدارات وتصاميم المطابخ 3D</h3>
        <p class="text-muted mb-0">إدارة ومراجعة المخططات الهندسية ومتابعة اعتماد العميل</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>كود الإصدار</th>
                        <th>طلب المطبخ</th>
                        <th>العميل</th>
                        <th>المصمم الداخلي</th>
                        <th>البرنامج المستخدم</th>
                        <th>الأمتار الطولية</th>
                        <th>حالة التصميم</th>
                        <th>تاريخ الرفع</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted">لا توجد تصاميم مسجلة حالياً.</td></tr>
                    }
                    @foreach (var d in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@d.VersionCode</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@d.KitchenRequestId" class="fw-bold text-decoration-none">
                                    @(d.KitchenRequest?.RequestNumber ?? $"طلب #{d.KitchenRequestId}")
                                </a>
                            </td>
                            <td><strong>@(d.KitchenRequest?.Customer?.Name ?? "-")</strong></td>
                            <td>@(d.Designer?.FullName ?? "المصمم الداخلي")</td>
                            <td><span class="badge bg-light text-dark border">@d.SoftwareUsed</span></td>
                            <td><strong>@d.EstimatedLinearMeters م.ط</strong></td>
                            <td>
                                @if (d.Status == DesignVersionStatus.ApprovedByCustomer)
                                {
                                    <span class="badge bg-success px-3 py-2"><i class="fa-solid fa-check-double me-1"></i> معتمد من العميل</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">@d.Status.ToArabic()</span>
                                }
                            </td>
                            <td class="text-muted"><small>@d.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                @if (d.Status != DesignVersionStatus.ApprovedByCustomer)
                                {
                                    <div class="btn-group btn-group-sm">
                                        <form asp-action="SendToCustomer" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="designId" value="@d.Id" />
                                            <button type="submit" class="btn btn-outline-info"><i class="fa-solid fa-paper-plane me-1"></i> إرسال للعميل</button>
                                        </form>
                                        <form asp-action="ApproveByCustomer" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="designId" value="@d.Id" />
                                            <input type="hidden" name="feedback" value="معتمد بالكامل" />
                                            <button type="submit" class="btn btn-success"><i class="fa-solid fa-check me-1"></i> اعتماد العميل</button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-light text-success border"><i class="fa-solid fa-lock"></i> مقفل ومعتمد</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>