@model KOSS.Web.Models.Contract
@{
    ViewData["Title"] = "تحرير عقد رسمي لمشروع المطبخ";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-file-contract text-primary me-2"></i> تحرير وتوقيع عقد رسمي لطلب المطبخ
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KitchenRequestId" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="QuotationId" class="form-label fw-bold">عرض السعر المعتمد</label>
                            <select asp-for="QuotationId" class="form-select" asp-items="ViewBag.Quotations">
                                <option value="">-- اختر عرض السعر المعتمد --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DesignVersionId" class="form-label fw-bold">إصدار التصميم المعتمد</label>
                            <select asp-for="DesignVersionId" class="form-select" asp-items="ViewBag.DesignVersions">
                                <option value="">-- اختر إصدار التصميم المعتمد --</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="TotalValue" class="form-label fw-bold">إجمالي قيمة العقد (د.ل)</label>
                            <input asp-for="TotalValue" type="number" step="0.001" class="form-control" placeholder="0.000" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RequiredDeposit" class="form-label fw-bold">قيمة العربون المشترط للبدء (د.ل) - 30%</label>
                            <input asp-for="RequiredDeposit" type="number" step="0.001" class="form-control" placeholder="0.000" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="SignedDate" class="form-label fw-bold">تاريخ توقيع العقد</label>
                            <input asp-for="SignedDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TargetCompletionDate" class="form-label fw-bold">الموعد المستهدف للتسليم والتركيب</label>
                            <input asp-for="TargetCompletionDate" type="date" class="form-control" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="PricePerMeter" class="form-label fw-bold">سعر المتر الطولي التعاقدي (د.ل)</label>
                            <input asp-for="PricePerMeter" type="number" step="0.001" class="form-control" placeholder="0.000" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TotalMeters" class="form-label fw-bold">إجمالي الأمتار الطولية</label>
                            <input asp-for="TotalMeters" type="number" step="0.1" class="form-control" placeholder="0.0" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="SpecialTerms" class="form-label fw-bold">شروط وضمانات إضافية في العقد</label>
                        <textarea asp-for="SpecialTerms" class="form-control" rows="3" placeholder="فترة الضمان، سياسة الصيانة، التزامات الموقع..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-file-signature me-1"></i> اعتماد وحفظ العقد الرسمي
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>