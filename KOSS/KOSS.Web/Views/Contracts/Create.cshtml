@model KOSS.Web.Models.Contract
@{
    ViewBag.Title = "تحرير عقد رسمي جديد";
    var req = ViewBag.Request as KOSS.Web.Models.KitchenRequest;
    var quo = ViewBag.Quotation as KOSS.Web.Models.Quotation;
    var des = ViewBag.Design as KOSS.Web.Models.DesignVersion;
}

<div class="page-header" style="margin-top:10px;">
    <h2>📋 تحرير العقد الرسمي واتفاقية التنفيذ
        <small>مشروع: <strong>@(req != null ? req.RequestNumber : "-")</strong> | العميل: <strong>@(req != null && req.Customer != null ? req.Customer.Name : "-")</strong></small>
    </h2>
</div>

@using (Html.BeginForm("Create", "Contracts", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.KitchenRequestId)
    @Html.HiddenFor(m => m.ClientId)
    @Html.HiddenFor(m => m.QuotationId)
    @Html.HiddenFor(m => m.DesignVersionId)

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-primary">
                <div class="panel-heading"><h4>بيانات وبنود العقد الأساسية</h4></div>
                <div class="panel-body">
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.ContractNumber, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.ContractNumber, new { @class = "form-control", @readonly = "readonly", style = "font-weight:bold; background:#f9f9f9;" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.SignedDate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.SignedDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.TotalValue, new { @class = "control-label" })
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.TotalValue, new { @class = "form-control", type = "number", step = "0.001", id = "totalVal", style = "font-weight:bold; color:#27ae60; font-size:1.1em;" })
                                    <span class="input-group-addon">د.ل</span>
                                </div>
                                @Html.ValidationMessageFor(m => m.TotalValue, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.RequiredDeposit, new { @class = "control-label" })
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.RequiredDeposit, new { @class = "form-control", type = "number", step = "0.001", id = "depositVal", style = "font-weight:bold; color:#e67e22; font-size:1.1em;" })
                                    <span class="input-group-addon">د.ل (30%)</span>
                                </div>
                                @Html.ValidationMessageFor(m => m.RequiredDeposit, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.PricePerMeter, new { @class = "control-label" })
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.PricePerMeter, new { @class = "form-control", type = "number", step = "0.001" })
                                    <span class="input-group-addon">د.ل / متر</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.TotalMeters, new { @class = "control-label" })
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.TotalMeters, new { @class = "form-control", type = "number", step = "0.01" })
                                    <span class="input-group-addon">متر طولي</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.TargetCompletionDate, new { @class = "control-label" })
                                @Html.TextBoxFor(m => m.TargetCompletionDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                @Html.LabelFor(m => m.PenaltyPerDay, new { @class = "control-label" })
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.PenaltyPerDay, new { @class = "form-control", type = "number", step = "0.001" })
                                    <span class="input-group-addon">د.ل / يوم تأخير</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Notes, new { @class = "control-label" })
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 3, placeholder = "الشروط والأحكام الخاصة بالضمان والتوريد والتركيب..." })
                    </div>

                    <hr />
                    <button type="submit" class="btn btn-success btn-lg">
                        💾 توقيع وحفظ العقد وتوليد جدول الدفعات (30% - 40% - 20% - 10%)
                    </button>
                    @if (req != null)
                    {
                        <a href="@Url.Action("Details", "Requests", new { id = req.Id })" class="btn btn-default btn-lg">إلغاء والعودة للطلب</a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Requests")" class="btn btn-default btn-lg">إلغاء</a>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- جدول الدفعات المعياري المعتمد -->
            <div class="panel panel-info">
                <div class="panel-heading"><h4>📅 جدول الدفعات القياسي للمنظومة</h4></div>
                <div class="panel-body">
                    <p class="text-muted">سيتم إنشاء جدول الدفعات التالي تلقائياً عند حفظ العقد:</p>
                    <table class="table table-bordered table-condensed">
                        <thead><tr class="info"><th>المرحلة</th><th>النسبة</th><th>الاستحقاق</th></tr></thead>
                        <tbody>
                            <tr><td><strong>1. عربون التعاقد</strong></td><td><strong class="text-warning">30%</strong></td><td>عند توقيع العقد</td></tr>
                            <tr><td><strong>2. دفعة بدء التصنيع</strong></td><td><strong class="text-primary">40%</strong></td><td>عند قص وتجهيز الخامات</td></tr>
                            <tr><td><strong>3. دفعة بدء التركيب</strong></td><td><strong class="text-info">20%</strong></td><td>عند التوريد للموقع</td></tr>
                            <tr><td><strong>4. مخالصة التسليم</strong></td><td><strong class="text-success">10%</strong></td><td>عند توقيع محضر التسليم</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            @if (quo != null)
            {
                <div class="panel panel-default">
                    <div class="panel-heading"><h5>عرض السعر المقترن</h5></div>
                    <div class="panel-body">
                        <p>رقم العرض: <strong>@quo.QuotationNumber</strong></p>
                        <p>إجمالي العرض: <strong class="text-success">@quo.TotalAmount.ToString("N3") د.ل</strong></p>
                        <p>تاريخ الصلاحية: @quo.ExpiryDate.ToString("yyyy/MM/dd")</p>
                    </div>
                </div>
            }
        </div>
    </div>
}

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var totalInput = document.getElementById("totalVal");
        var depositInput = document.getElementById("depositVal");
        if (totalInput && depositInput) {
            totalInput.addEventListener("input", function () {
                var v = parseFloat(totalInput.value) || 0;
                depositInput.value = (v * 0.30).toFixed(3);
            });
        }
    });
</script>


