@model IEnumerable<KOSS.Web.Models.Contract>
@{
    ViewData["Title"] = "العقود والاتفاقيات الرسمية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-file-contract text-danger me-2"></i> العقود والاتفاقيات الرسمية وجدول الدفعات</h3>
        <p class="text-muted mb-0">إدارة العقود السارية، ومتابعة تحصيل الدفعات المالية الأربعة</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم العقد</th>
                        <th>طلب المطبخ</th>
                        <th>العميل</th>
                        <th>إجمالي قيمة العقد</th>
                        <th>المحصل الفعلي</th>
                        <th>المتبقي للتحصيل</th>
                        <th>حالة العقد</th>
                        <th>تاريخ التوقيع</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-5 text-muted">لا توجد عقود مسجلة حالياً.</td></tr>
                    }
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@c.ContractNumber</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@c.KitchenRequestId" class="fw-bold text-decoration-none">
                                    @(c.KitchenRequest?.RequestNumber ?? $"طلب #{c.KitchenRequestId}")
                                </a>
                            </td>
                            <td><strong>@(c.KitchenRequest?.Customer?.Name ?? "-")</strong></td>
                            <td><strong class="text-dark">@c.TotalValue.ToString("N3") د.ل</strong></td>
                            <td><strong class="text-success">@c.TotalPaid.ToString("N3") د.ل</strong></td>
                            <td><strong class="text-danger">@c.RemainingBalance.ToString("N3") د.ل</strong></td>
                            <td><span class="badge bg-success px-3 py-2">@c.Status.ToArabic()</span></td>
                            <td class="text-muted"><small>@c.SignedDate.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@c.KitchenRequestId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-folder-open me-1"></i> فتح ملف المشروع
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>