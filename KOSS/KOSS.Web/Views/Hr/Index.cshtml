@model IEnumerable<KOSS.Web.Models.StaffMember>
@{
    ViewData["Title"] = "فريق العمل والموظفين والفنيين";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-user-tie text-secondary me-2"></i> فريق العمل والموظفين والفنيين</h3>
        <p class="text-muted mb-0">إدارة المهندسين، والمصممين، ومسؤولي المبيعات، وفنيي المصنع والتركيب</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>الاسم الكامل</th>
                        <th>المسمى الوظيفي والدور</th>
                        <th>رقم الهاتف</th>
                        <th>البريد الإلكتروني</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">لا يوجد موظفين مسجلين.</td></tr>
                    }
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">#@staff.Id</strong></td>
                            <td><strong class="text-dark">@staff.FullName</strong></td>
                            <td><span class="badge bg-light text-dark border">@staff.Role</span></td>
                            <td><span dir="ltr">@(staff.Phone ?? "-")</span></td>
                            <td><small class="text-muted">@(staff.Email ?? "-")</small></td>
                            <td>
                                @if (staff.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-2">على رأس العمل</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">موقف / إجازة</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>