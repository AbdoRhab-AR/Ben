@model IEnumerable<KOSS.Web.Models.StaffMember>
@{
    ViewData["Title"] = "تقرير مسيرات الرواتب والمكافآت";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-money-check-dollar text-success me-2"></i> تقرير الرواتب والمكافآت والحوافز</h3>
        <p class="text-muted mb-0">بيان الرواتب الأساسية ومكافآت الإنجاز الميداني ومصممي المشاريع</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم الموظف</th>
                        <th>الدور الوظيفي</th>
                        <th>الراتب الأساسي</th>
                        <th>رصيد المكافآت المتراكمة</th>
                        <th>إجمالي الاستحقاق الشهري</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">لا توجد بيانات رواتب.</td></tr>
                    }
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">#@s.Id</strong></td>
                            <td><strong class="text-dark">@s.FullName</strong></td>
                            <td><span class="badge bg-light text-dark border">@s.Role</span></td>
                            <td>@s.BaseSalary.ToString("N3") د.ل</td>
                            <td><strong class="text-success">@s.BonusBalance.ToString("N3") د.ل</strong></td>
                            <td><strong class="text-primary fs-6">@s.TotalMonthlyPay.ToString("N3") د.ل</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>