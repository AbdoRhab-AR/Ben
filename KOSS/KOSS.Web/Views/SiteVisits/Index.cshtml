@model IEnumerable<KOSS.Web.Models.SiteVisit>
@{
    ViewBag.Title = "المعاينات والقياسات الميدانية";
}

<div class="page-header">
    <h2>📏 المعاينات والقياسات الميدانية
        <small>(المرحلة 3: رفع القياسات والنقاط الفنية بالموقع)</small>
    </h2>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><h4>📋 جدول المعاينات والزيارات الميدانية (@Model.Count())</h4></div>
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="thead-koss">
                <tr>
                    <th>#</th>
                    <th>رقم الطلب</th>
                    <th>العميل</th>
                    <th>الموقع</th>
                    <th>المهندس المكلف</th>
                    <th>الموعد المجدول</th>
                    <th>الأبعاد (سم)</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted">لا توجد معاينات مسجلة حالياً.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>
                            <a href="@Url.Action("Details", "Requests", new { id = s.KitchenRequestId })" style="font-weight:bold;">
                                📁 @(s.KitchenRequest != null ? s.KitchenRequest.RequestNumber : "-")
                            </a>
                        </td>
                        <td><strong>@(s.KitchenRequest != null && s.KitchenRequest.Customer != null ? s.KitchenRequest.Customer.Name : "-")</strong></td>
                        <td><small>@(s.KitchenRequest != null ? s.KitchenRequest.Location : "-")</small></td>
                        <td>@(s.AssignedSurveyor != null ? s.AssignedSurveyor.FullName : "غير معين")</td>
                        <td>@(s.ScheduledDate.HasValue ? s.ScheduledDate.Value.ToString("yyyy/MM/dd") : "-")</td>
                        <td>
                            @if (s.WallLength1Cm.HasValue)
                            {
                                <span>@s.WallLength1Cm x @s.WallLength2Cm</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td>
                            @if (s.Status == SiteVisitStatus.Approved)
                            {
                                <span class="label label-success">@s.Status</span>
                            }
                            else
                            {
                                <span class="label label-warning">@s.Status</span>
                            }
                        </td>
                        <td>
                            <a href="@Url.Action("RecordMeasurements", new { id = s.Id })" class="btn btn-xs btn-default">📐 إدخال القياسات</a>
                            @if (s.Status != SiteVisitStatus.Approved)
                            {
                                using (Html.BeginForm("Approve", "SiteVisits", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="visitId" value="@s.Id" />
                                    <button type="submit" class="btn btn-xs btn-success">✅ اعتماد المعاينة</button>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
