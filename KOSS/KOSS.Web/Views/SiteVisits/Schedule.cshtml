@model KOSS.Web.Models.SiteVisit
@{
    ViewData["Title"] = "جدولة موعد معاينة ميدانية";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-calendar-plus text-primary me-2"></i> جدولة موعد معاينة ميدانية بالليزر
            </div>
            <div class="card-body p-4">
                <form asp-action="Schedule" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="KitchenRequestId" />

                    <div class="mb-3">
                        <label asp-for="ScheduledDate" class="form-label fw-bold">تاريخ المعاينة الميدانية</label>
                        <input asp-for="ScheduledDate" type="date" class="form-control" value="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedSurveyorId" class="form-label fw-bold">المهندس المساح المسؤول</label>
                        <select asp-for="AssignedSurveyorId" class="form-select" asp-items="ViewBag.Surveyors">
                            <option value="">-- اختر مهندس المساحة الميداني --</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات وتوجيهات الزيارة الميدانية</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="توجيهات الموقع، أوقات تواجد العميل، شروط الدخول..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> إلغاء
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-calendar-check me-1"></i> تأكيد جدولة الموعد
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>