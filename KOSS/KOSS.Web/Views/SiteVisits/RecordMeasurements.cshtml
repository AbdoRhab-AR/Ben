@model KOSS.Web.Models.SiteVisit
@{
    ViewData["Title"] = "توثيق القياسات الميدانية 3D";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-pen-ruler text-primary me-2"></i> توثيق القياسات الهندسية وتقرير الموقع الميداني
            </div>
            <div class="card-body p-4">
                <form asp-action="RecordMeasurements" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="KitchenRequestId" />

                    <h6 class="fw-bold text-primary mb-3"><i class="fa-solid fa-arrows-up-down-left-right me-1"></i> الأبعاد الهندسية لجدران المطبخ (بالسنتيمتر)</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="WallLength1Cm" class="form-label fw-bold">طول الجدار الرئيسي (سم)</label>
                            <input asp-for="WallLength1Cm" type="number" step="0.1" class="form-control" placeholder="مثال: 450" required />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="WallLength2Cm" class="form-label fw-bold">طول الجدار الثاني (سم)</label>
                            <input asp-for="WallLength2Cm" type="number" step="0.1" class="form-control" placeholder="مثال: 320" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CeilingHeightCm" class="form-label fw-bold">ارتفاع السقف (سم)</label>
                            <input asp-for="CeilingHeightCm" type="number" step="0.1" class="form-control" placeholder="مثال: 290" required />
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary mb-3"><i class="fa-solid fa-faucet-drip me-1"></i> تمديدات وتغذية الموقع</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PlumbingNotes" class="form-label fw-bold">تقرير تمديدات السباكة والصرف</label>
                            <input asp-for="PlumbingNotes" type="text" class="form-control" placeholder="موقع مخرج المياه والصرف، فتحات التغذية..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ElectricalNotes" class="form-label fw-bold">تقرير نقاط الكهرباء والأفياش</label>
                            <input asp-for="ElectricalNotes" type="text" class="form-control" placeholder="مواقع مقابس 220V، مخرج الشفاط، الإنارة المخفية..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="StructuralObstacles" class="form-label fw-bold">العوائق الإنشائية والبروزات (أعمدة، كمرات، نوافذ)</label>
                        <textarea asp-for="StructuralObstacles" class="form-control" rows="2" placeholder="أي بروز معماري أو عائق يؤثر على تركيب الخزائن..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Requests" asp-action="Details" asp-route-id="@Model.KitchenRequestId" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            <i class="fa-solid fa-floppy-disk me-1"></i> حفظ القياسات والتقرير
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>