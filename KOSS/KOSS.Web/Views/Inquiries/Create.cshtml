@model KOSS.Web.Models.CustomerInquiry
@{
    ViewBag.Title = "تسجيل استفسار جديد";
}

<div class="page-header">
    <h2>📞 تسجيل استفسار وفرصة بيعية جديدة
        <small>(المرحلة 1: تتبع العملاء)</small>
    </h2>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading"><h4>بيانات الاستفسار</h4></div>
            <div class="panel-body">
                @using (Html.BeginForm("Create", "Inquiries", FormMethod.Post, new { @class = "form-horizontal" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                    <div class="form-group">
                        <label class="col-md-4 control-label">العميل</label>
                        <div class="col-md-8">
                            @Html.DropDownListFor(m => m.CustomerId, (SelectList)ViewBag.Customers, "--- اختر العميل ---", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.CustomerId, "", new { @class = "text-danger" })
                            <small><a href="@Url.Action("Create", "Clients")" target="_blank">➕ إضافة عميل جديد إن لم يكن موجوداً</a></small>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Location, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "موقع المطبخ / المدينة / الحي" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.EstimatedAreaM2, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextBoxFor(m => m.EstimatedAreaM2, new { @class = "form-control", placeholder = "المساحة التقريبية (م²)" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.EstimatedBudget, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            <div class="input-group">
                                @Html.TextBoxFor(m => m.EstimatedBudget, new { @class = "form-control", placeholder = "الميزانية المتوقعة للعميل" })
                                <span class="input-group-addon">د.ل</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.PreferredLayout, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.EnumDropDownListFor(m => m.PreferredLayout, new { @class = "form-control" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(m => m.Notes, new { @class = "col-md-4 control-label" })
                        <div class="col-md-8">
                            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 3, placeholder = "تفاصيل أول اتصال، متطلبات خاصة..." })
                        </div>
                    </div>

                    <hr />
                    <div class="form-group">
                        <div class="col-md-8 col-md-offset-4">
                            <button type="submit" class="btn btn-warning btn-lg">💾 حفظ الاستفسار</button>
                            <a href="@Url.Action("Index")" class="btn btn-default btn-lg">إلغاء</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
