@model KOSS.Web.Models.CustomerInquiry
@{
    ViewData["Title"] = "تسجيل استفسار وفرصة بيعية";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-header card-header-custom">
                <i class="fa-solid fa-headset text-success me-2"></i> تسجيل استفسار وفرصة بيعية جديدة
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="CustomerId" class="form-label fw-bold">العميل</label>
                        <select asp-for="CustomerId" class="form-select" required>
                            <option value="">-- اختر العميل --</option>
                            @if (ViewBag.Customers is IEnumerable<KOSS.Web.Models.Customer> customers)
                            {
                                foreach (var c in customers)
                                {
                                    <option value="@c.Id">@c.Name (@c.Phone)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-bold">المدينة / المنطقة</label>
                            <input asp-for="Location" class="form-control" placeholder="طرابلس، السراج، حي الأندلس..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PreferredLayout" class="form-label fw-bold">التخطيط المقترح</label>
                            <select asp-for="PreferredLayout" class="form-select">
                                <option value="">-- غير محدد --</option>
                                <option value="Straight">خطي مستقيم</option>
                                <option value="LShaped">حرف L</option>
                                <option value="UShaped">حرف U</option>
                                <option value="Island">مع جزيرة وسطية</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-bold">ملاحظات واحتياجات العميل</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="استفسار العميل، الميزانية التقريبية، موعد البناء..."></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
                        </a>
                        <button type="submit" class="btn btn-koss-primary px-4">
                            <i class="fa-solid fa-save me-1"></i> حفظ الاستفسار
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
