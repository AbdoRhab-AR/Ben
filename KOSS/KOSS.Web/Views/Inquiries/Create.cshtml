@model KOSS.Web.Models.CustomerInquiry
@{
    ViewData["Title"] = "تسجيل استفسار بيعي";
    var customers = ViewBag.Customers as List<KOSS.Web.Models.Customer> ?? new List<KOSS.Web.Models.Customer>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-headset text-primary me-2"></i> تسجيل استفسار وفرصة بيع جديدة</h3>
        <p class="text-muted mb-0">المرحلة الأولى في مسار العمل (تسجيل العميل المحتمل والاهتمامات)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للاستفسارات
    </a>
</div>

<div class="card card-custom" style="max-width: 800px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="CustomerId" class="form-label fw-bold"></label>
                <select asp-for="CustomerId" class="form-select">
                    <option value="0">--- عميل جديد (أدخل البيانات بالأسفل) ---</option>
                    @foreach (var c in customers)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.CustomerId ? "selected" : null)">@c.Name (@c.Phone)</option>
                    }
                </select>
            </div>

            <div class="p-3 bg-light rounded mb-3 border">
                <h6 class="fw-bold text-secondary mb-2">أو بيانات عميل جديد:</h6>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">اسم العميل</label>
                        <input type="text" name="customerName" class="form-control" placeholder="الاسم كاملاً" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">رقم الهاتف</label>
                        <input type="text" name="customerPhone" class="form-control" placeholder="09xxxxxxxx" />
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="PreferredLayout" class="form-label fw-bold"></label>
                    <select asp-for="PreferredLayout" asp-items="Html.GetEnumSelectList<KitchenLayoutType>()" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label fw-bold"></label>
                    <input asp-for="Location" class="form-control" placeholder="المدينة / المنطقة" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label fw-bold"></label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="تفاصيل الطلب والاحتياجات المبدئية..."></textarea>
            </div>

            <hr />
            <button type="submit" class="btn btn-koss-primary px-4 py-2">
                <i class="fa-solid fa-floppy-disk me-1"></i> حفظ الاستفسار
            </button>
        </form>
    </div>
</div>
