@model IEnumerable<KOSS.Web.Models.CustomerInquiry>
@{
    ViewData["Title"] = "الاستفسارات والفرص البيعية";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-headset text-success me-2"></i> الاستفسارات والفرص البيعية للعملاء</h3>
        <p class="text-muted mb-0">المتابعة الأولية لطلبات العملاء قبل تحويلها إلى مشاريع رسمية</p>
    </div>
    <a asp-action="Create" class="btn btn-koss-primary">
        <i class="fa-solid fa-plus me-1"></i> تسجيل استفسار جديد
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم العميل</th>
                        <th>رقم الهاتف</th>
                        <th>المدينة والموقع</th>
                        <th>التخطيط المفضل</th>
                        <th>تاريخ الاستفسار</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد استفسارات مسجلة حالياً.</td></tr>
                    }
                    @foreach (var inq in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">#@inq.Id</strong></td>
                            <td><strong class="text-dark">@(inq.Customer?.Name ?? "-")</strong></td>
                            <td><span dir="ltr">@(inq.Customer?.Phone ?? "-")</span></td>
                            <td>@(inq.Location ?? inq.Customer?.District ?? "-")</td>
                            <td>
                                @if (inq.PreferredLayout.HasValue)
                                {
                                    <span class="badge bg-light text-dark border">@inq.PreferredLayout.Value.ToArabic()</span>
                                }
                                else
                                {
                                    <span class="text-muted small">غير محدد</span>
                                }
                            </td>
                            <td class="text-muted"><small>@inq.CreatedAt.ToString("yyyy/MM/dd")</small></td>
                            <td>
                                @if (inq.ConvertedKitchenRequestId.HasValue)
                                {
                                    <a asp-controller="Requests" asp-action="Details" asp-route-id="@inq.ConvertedKitchenRequestId" class="btn btn-sm btn-outline-success">
                                        <i class="fa-solid fa-folder-open me-1"></i> فتح طلب المطبخ
                                    </a>
                                }
                                else
                                {
                                    <form asp-action="ConvertToRequest" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="inquiryId" value="@inq.Id" />
                                        <button type="submit" class="btn btn-sm btn-koss-primary">
                                            <i class="fa-solid fa-arrow-right-arrow-left me-1"></i> تحويل لطلب مطبخ
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
