@model IEnumerable<KOSS.Web.Models.Contract>
@{
    ViewBag.Title = "المسح الميداني";
}

<div class="page-header">
    <h2>📐 المسح الميداني ورسوم التصميم</h2>
</div>

<div class="panel panel-default">
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover">
            <thead class="thead-koss">
                <tr>
                    <th>رقم العقد</th><th>العميل</th><th>الهاتف</th>
                    <th>الحالة</th><th>تاريخ الإنشاء</th><th>الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td><strong>@c.ContractNumber</strong></td>
                        <td>@(c.Client != null ? c.Client.Name : "-")</td>
                        <td dir="ltr">@(c.Client != null ? c.Client.Phone : "-")</td>
                        <td><span class="label label-info">@c.Status</span></td>
                        <td>@c.CreatedAt.ToString("yyyy/MM/dd")</td>
                        <td>
                            <a href="@Url.Action("EnterMeasurements", new{id=c.Id})"
                               class="btn btn-xs btn-primary">📏 إدخال القياسات</a>
                            @if (c.Status == ContractStatus.Measured)
                            {
                                <a href="@Url.Action("PayFee", new{contractId=c.Id})"
                                   class="btn btn-xs btn-success">💳 رسوم التصميم</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
