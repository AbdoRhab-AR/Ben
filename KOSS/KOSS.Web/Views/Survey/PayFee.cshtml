@model KOSS.Web.Models.Contract
@{
    ViewBag.Title = "دفع رسوم التصميم";
    int unitCount = Model.Units.Count;
    decimal fee   = KOSS.Web.Models.DesignFee.CalculateFee(unitCount);
    bool needsMgr = KOSS.Web.Models.DesignFee.RequiresManagerApproval(unitCount);
}

<div class="page-header">
    <h2>💳 دفع رسوم التصميم
        <small>العميل: <strong>@(Model.Client != null ? Model.Client.Name : "-")</strong></small>
    </h2>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="panel panel-success">
            <div class="panel-heading"><h4>جدول رسوم التصميم</h4></div>
            <div class="panel-body">
                <table class="table table-bordered">
                    <thead class="thead-koss">
                        <tr><th>عدد الوحدات</th><th>الرسوم (د.ل)</th><th>ملاحظة</th></tr>
                    </thead>
                    <tbody>
                        <tr class="@(unitCount == 1 ? "success" : "")"><td>1 وحدة</td><td><strong>300</strong></td><td>سعر قياسي</td></tr>
                        <tr class="@(unitCount == 2 ? "success" : "")"><td>2 وحدة</td><td><strong>600</strong></td><td>سعر قياسي</td></tr>
                        <tr class="@(unitCount >= 3 && unitCount <= 4 ? "success" : "")"><td>3-4 وحدة</td><td><strong>1,200</strong></td><td>خصم متعدد الوحدات</td></tr>
                        <tr class="@(unitCount >= 5 ? "warning" : "")"><td>5+ وحدات</td><td>تفاوضي</td><td>يتطلب موافقة المدير</td></tr>
                    </tbody>
                </table>

                @if (needsMgr)
                {
                    <div class="alert alert-warning">
                        ⚠️ <strong>5 وحدات أو أكثر:</strong> يتطلب موافقة مدير قبل تحديد الرسوم.
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        عدد الوحدات: <strong>@unitCount</strong> — الرسوم المحسوبة: <strong>@fee.ToString("N3") د.ل</strong>
                    </div>
                }
            </div>
        </div>

        @using (Html.BeginForm("ConfirmPayFee", "Survey", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="contractId" value="@Model.Id" />

            <div class="panel panel-default">
                <div class="panel-heading"><h4>تأكيد الاستلام</h4></div>
                <div class="panel-body">
                    <div class="form-group">
                        <label>المبلغ المستلم (د.ل)</label>
                        <div class="input-group">
                            <input type="number" name="feeAmount" class="form-control input-lg"
                                   value="@fee" step="0.001" min="0" required />
                            <span class="input-group-addon">د.ل</span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>ملاحظات</label>
                        <textarea name="notes" class="form-control" rows="2"
                                  placeholder="مثلاً: مدفوعة نقداً بتاريخ..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg btn-block" @(needsMgr ? "disabled" : "")>
                        ✅ تأكيد الاستلام وإصدار الإيصال
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="col-md-6">
        <div class="panel panel-default">
            <div class="panel-heading"><h4>📋 وحدات العقد (@unitCount)</h4></div>
            <div class="panel-body">
                @foreach (var unit in Model.Units)
                {
                    <div class="factory-card">
                        <strong>@unit.UnitType</strong>
                        @if (!string.IsNullOrEmpty(unit.Description))
                        {
                            <small> — @unit.Description</small>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="alert alert-info">
            <strong>ℹ️</strong> رسوم التصميم غير قابلة للاسترداد وتُخصم من الفاتورة النهائية عند توقيع العقد.
        </div>
    </div>
</div>
