@model KOSS.Web.Models.Contract
@{
    ViewBag.Title = "إتمام التشطيب والتسليم النهائي";
    decimal finalBalance = ViewBag.FinalBalance != null ? (decimal)ViewBag.FinalBalance : Model.RemainingBalance;
}

<div class="page-header">
    <h2>🎉 إتمام التشطيب والتسليم النهائي (Commissioning)
        <small>العقد: <strong>@Model.ContractNumber</strong> | العميل: <strong>@(Model.Client != null ? Model.Client.Name : "-")</strong></small>
        <a href="@Url.Action("Index")" class="btn btn-default pull-left">← العودة للمصنع</a>
    </h2>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="panel panel-success">
            <div class="panel-heading"><h4>إغلاق الملف المالي والتنفيذي للعقد</h4></div>
            <div class="panel-body">
                <div class="row koss-finance-summary">
                    <div class="col-md-4 text-center">
                        <div class="finance-box">
                            <div class="finance-amount">@Model.TotalValue.ToString("N0")</div>
                            <div class="finance-label">إجمالي العقد (د.ل)</div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="finance-box finance-paid">
                            <div class="finance-amount">@Model.TotalPaid.ToString("N0")</div>
                            <div class="finance-label">المدفوع مسبقاً (د.ل)</div>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="finance-box finance-remaining">
                            <div class="finance-amount">@finalBalance.ToString("N0")</div>
                            <div class="finance-label">المتبقي للتسليم (د.ل)</div>
                        </div>
                    </div>
                </div>

                @using (Html.BeginForm("ConfirmCommission", "Factory", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="contractId" value="@Model.Id" />

                    <div class="form-group">
                        <label class="control-label">مبلغ الدفعة النهائية المستلمة (د.ل)</label>
                        <div class="input-group">
                            <input type="number" name="finalPayment" class="form-control input-lg" value="@finalBalance" step="0.001" min="0" required />
                            <span class="input-group-addon">د.ل</span>
                        </div>
                        <small class="text-muted">المبلغ الافتراضي هو كامل الرصيد المتبقي لإقفال الحساب.</small>
                    </div>

                    <hr />
                    <button type="submit" class="btn btn-success btn-lg btn-block">
                        🏁 تأكيد استلام الدفعة النهائية وإغلاق العقد (Completed)
                    </button>
                }
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="panel panel-info">
            <div class="panel-heading"><h4>ℹ️ ما يترتب على إغلاق العقد</h4></div>
            <div class="panel-body">
                <ul>
                    <li>يتم تحديث حالة العقد إلى <span class="label label-success">Completed</span>.</li>
                    <li>يتم إصدار إيصال سداد نهائي في سجل المدفوعات.</li>
                    <li>تعتبر جميع الوحدات مكتملة ومسلمة للعميل رسمياً.</li>
                    <li>يتم إدراج العقد في التقارير الختامية وكشوفات الأرباح.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
