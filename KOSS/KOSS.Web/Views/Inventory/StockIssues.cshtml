@model IEnumerable<KOSS.Web.Models.StockIssue>
@{
    ViewData["Title"] = "سندات صرف الخامات لمشاريع المطابخ";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-dolly text-primary me-2"></i> سندات صرف الخامات للمصنع والمشاريع</h3>
        <p class="text-muted mb-0">توثيق المواد والألواح والإكسسوارات المصروفة فعلياً لكل أمر تشغيل</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم السند</th>
                        <th>طلب المطبخ</th>
                        <th>أمر التشغيل</th>
                        <th>المستودع المصروف منه</th>
                        <th>المستلم (الفني / الفريق)</th>
                        <th>إجمالي تكلفة المواد</th>
                        <th>تاريخ وساعة الصرف</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد سندات صرف مسجلة.</td></tr>
                    }
                    @foreach (var issue in Model)
                    {
                        <tr>
                            <td><strong class="text-primary font-monospace">@issue.IssueNumber</strong></td>
                            <td>
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@issue.KitchenRequestId" class="fw-bold text-decoration-none">
                                    @(issue.KitchenRequest?.RequestNumber ?? $"طلب #{issue.KitchenRequestId}")
                                </a>
                            </td>
                            <td>@(issue.WorkOrder?.OrderNumber ?? "-")</td>
                            <td>@(issue.Warehouse?.Name ?? "المستودع الرئيسي")</td>
                            <td><strong>@issue.RecipientName</strong></td>
                            <td><strong class="text-danger">@issue.TotalCost.ToString("N3") د.ل</strong></td>
                            <td class="text-muted"><small>@issue.IssuedAt.ToString("yyyy/MM/dd HH:mm")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
