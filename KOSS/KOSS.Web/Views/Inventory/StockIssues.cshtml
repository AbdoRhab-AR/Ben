@model IEnumerable<KOSS.Web.Models.StockIssue>
@{
    ViewBag.Title = "سجل سندات الصرف للمشاريع";
}

<div class="page-header">
    <h2>📋 سجل سندات الصرف المخزني للمشاريع
        <small>(ربط الخامات المصروفة بمراكز تكلفة طلبات المطابخ)</small>
        <a href="@Url.Action("Index")" class="btn btn-default pull-left">← العودة للأرصدة</a>
    </h2>
</div>

<div class="panel panel-default">
    <div class="panel-heading"><h4>سندات الصرف الصادرة (@Model.Count())</h4></div>
    <div class="panel-body table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="thead-koss">
                <tr>
                    <th>رقم السند</th>
                    <th>رقم الطلب</th>
                    <th>العميل</th>
                    <th>المستودع</th>
                    <th>المستلم</th>
                    <th>إجمالي التكلفة</th>
                    <th>التاريخ</th>
                    <th>المعتمد</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted">لا توجد سندات صرف صادرة حتى الآن.</td></tr>
                }
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>@s.IssueNumber</strong></td>
                        <td>
                            <a href="@Url.Action("Details", "Requests", new { id = s.KitchenRequestId })" style="font-weight:bold;">
                                📁 @(s.KitchenRequest != null ? s.KitchenRequest.RequestNumber : "-")
                            </a>
                        </td>
                        <td><strong>@(s.KitchenRequest != null && s.KitchenRequest.Customer != null ? s.KitchenRequest.Customer.Name : "-")</strong></td>
                        <td>@(s.Warehouse != null ? s.Warehouse.Name : "-")</td>
                        <td>@s.RecipientName</td>
                        <td class="text-success"><strong>@s.TotalCost.ToString("N3") د.ل</strong></td>
                        <td>@s.IssuedAt.ToString("yyyy/MM/dd HH:mm")</td>
                        <td><small>@s.ApprovedBy</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
