@model IEnumerable<KOSS.Web.Models.ItemMaster>
@{
    ViewData["Title"] = "المستودعات والخامات";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-boxes-stacked text-primary me-2"></i> المستودعات ودليل الخامات والأصناف</h3>
        <p class="text-muted mb-0">متابعة أرصدة الأخشاب، الرخام، المفصلات، والإكسسوارات وسندات الصرف للمشاريع</p>
    </div>
    <a asp-action="StockIssues" class="btn btn-outline-primary">
        <i class="fa-solid fa-file-lines me-1"></i> سجل سندات الصرف
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>كود الصنف</th>
                        <th>اسم الخامة / الصنف</th>
                        <th>الفئة</th>
                        <th>الوحدة</th>
                        <th>التكلفة القياسية</th>
                        <th>سعر البيع القياسي</th>
                        <th>الرصيد المتوفر بالمخازن</th>
                        <th>حد إعادة الطلب</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="9" class="text-center py-4 text-muted">لا توجد أصناف معرفة حالياً في المخازن.</td></tr>
                    }
                    @foreach (var i in Model)
                    {
                        var totalStock = i.StockItems?.Sum(s => s.AvailableQuantity) ?? 0;
                        <tr>
                            <td><strong class="text-secondary">@i.ItemCode</strong></td>
                            <td><strong>@i.Name</strong></td>
                            <td><span class="badge bg-light text-dark border">@i.Category</span></td>
                            <td>@i.Unit</td>
                            <td>@i.StandardCost.ToString("N3") د.ل</td>
                            <td>@i.StandardSalePrice.ToString("N3") د.ل</td>
                            <td>
                                @if (totalStock <= i.ReorderLevel)
                                {
                                    <span class="badge bg-danger fs-6">@totalStock @i.Unit (منخفض)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success fs-6">@totalStock @i.Unit</span>
                                }
                            </td>
                            <td>@i.ReorderLevel @i.Unit</td>
                            <td>
                                @if (i.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">غير نشط</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
