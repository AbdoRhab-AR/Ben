@model IEnumerable<KOSS.Web.Models.ItemMaster>
@{
    ViewData["Title"] = "المستودعات والخامات والأرصدة";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark"><i class="fa-solid fa-boxes-stacked text-info me-2"></i> المستودعات وخامات الألواح والإكسسوارات</h3>
        <p class="text-muted mb-0">مراقبة خامات الإنتاج، والألواح، والمقابض، والمفصلات، والأرصدة المتاحة</p>
    </div>
</div>

<div class="card card-custom">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-custom table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>كود الصنف</th>
                        <th>اسم الخامة / الصنف</th>
                        <th>الفئة الرئيسية</th>
                        <th>الوحدة</th>
                        <th>الرصيد الفعلي الإجمالي</th>
                        <th>المتاح للصرف</th>
                        <th>متوسط التكلفة (WAC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">لا توجد خامات مسجلة في المستودعات.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        var totalPhys = item.StockItems?.Sum(s => s.PhysicalQuantity) ?? 0;
                        var totalAvail = item.StockItems?.Sum(s => s.AvailableQuantity) ?? 0;
                        var avgCost = item.StockItems?.FirstOrDefault()?.WeightedAverageCost ?? 0;
                        <tr>
                            <td><strong class="text-primary font-monospace">@item.ItemCode</strong></td>
                            <td><strong class="text-dark">@item.Name</strong></td>
                            <td><span class="badge bg-light text-dark border">@item.Category</span></td>
                            <td>@item.Unit</td>
                            <td><strong>@totalPhys @item.Unit</strong></td>
                            <td><span class="badge bg-success fs-6">@totalAvail @item.Unit</span></td>
                            <td>@avgCost.ToString("N3") د.ل</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
