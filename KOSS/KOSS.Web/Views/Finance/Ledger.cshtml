@model KOSS.Web.Models.Contract
@{
    ViewBag.Title = "كشف حساب العقد - " + Model.ContractNumber;
}

<div class="page-header">
    <h2>📊 كشف حساب تفصيلي
        <small>العقد: <strong>@Model.ContractNumber</strong> | العميل: <strong>@(Model.Client != null ? Model.Client.Name : "-")</strong></small>
        <a href="@Url.Action("Index")" class="btn btn-default pull-left">← العودة للمالية</a>
    </h2>
</div>

<div class="row">
    <!-- بطاقات الملخص -->
    <div class="col-md-4">
        <div class="stat-card stat-blue">
            <div class="stat-icon">📋</div>
            <div class="stat-info">
                <h3>@Model.TotalValue.ToString("N3") <small>د.ل</small></h3>
                <p>إجمالي قيمة العقد</p>
                <small>سعر المتر: @Model.PricePerMeter.ToString("N3") د.ل</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-green">
            <div class="stat-icon">💰</div>
            <div class="stat-info">
                <h3>@Model.TotalPaid.ToString("N3") <small>د.ل</small></h3>
                <p>إجمالي المدفوع</p>
                <small>نسبة السداد: @Model.PaymentPercentage.ToString("F1")%</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card stat-red">
            <div class="stat-icon">⏳</div>
            <div class="stat-info">
                <h3>@Model.RemainingBalance.ToString("N3") <small>د.ل</small></h3>
                <p>المتبقي للتحصيل</p>
                <small>الحالة: @Model.Status</small>
            </div>
        </div>
    </div>
</div>

<div class="row" style="margin-top:20px;">
    <!-- جدول الدفعات -->
    <div class="col-md-7">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4>💵 سجل الدفعات المستلمة (@Model.Payments.Count)
                    <a href="@Url.Action("RecordPayment", new { contractId = Model.Id })" class="btn btn-sm btn-success pull-left">➕ تسجيل دفعة</a>
                </h4>
            </div>
            <div class="panel-body table-responsive">
                <table class="table table-striped table-hover table-bordered">
                    <thead class="thead-koss">
                        <tr>
                            <th>رقم الإيصال</th>
                            <th>المبلغ (د.ل)</th>
                            <th>النوع</th>
                            <th>الطريقة</th>
                            <th>التاريخ</th>
                            <th>المستلم</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Payments.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted">لا توجد دفعات مسجلة حتى الآن</td></tr>
                        }
                        @foreach (var p in Model.Payments.OrderBy(x => x.PaidAt))
                        {
                            <tr>
                                <td><strong>@p.ReceiptNumber</strong></td>
                                <td class="text-success"><strong>@p.Amount.ToString("N3")</strong></td>
                                <td>@p.PaymentType</td>
                                <td>@p.PaymentMethod</td>
                                <td>@p.PaidAt.ToString("yyyy/MM/dd")</td>
                                <td><small>@p.ReceivedBy</small></td>
                                <td>
                                    <a href="@Url.Action("DownloadReceipt", new { id = p.Id })" class="btn btn-xs btn-primary">🖨️ PDF</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- وحدات العقد ورسوم التصميم -->
    <div class="col-md-5">
        <div class="panel panel-default">
            <div class="panel-heading"><h4>📐 وحدات العقد وتمويل العربون</h4></div>
            <div class="panel-body table-responsive">
                <table class="table table-bordered">
                    <thead class="thead-koss">
                        <tr>
                            <th>الوحدة</th>
                            <th>القيمة التقديرية</th>
                            <th>المطلوب (70%)</th>
                            <th>المخصص</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.Units.OrderBy(x => x.Priority))
                        {
                            decimal req70 = u.EstimatedValue * (u.RequiredDepositPercentage / 100m);
                            <tr>
                                <td><strong>@u.UnitType</strong></td>
                                <td>@u.EstimatedValue.ToString("N3")</td>
                                <td>@req70.ToString("N3")</td>
                                <td class="text-success">@u.AllocatedDeposit.ToString("N3")</td>
                                <td>
                                    <span class="label @(u.ManufacturingStatus == UnitManufacturingStatus.Active ? "label-success" : "label-warning")">
                                        @u.ManufacturingStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.DesignFees.Any())
        {
            var df = Model.DesignFees.FirstOrDefault();
            <div class="panel panel-info">
                <div class="panel-heading"><h4>🎨 رسوم التصميم</h4></div>
                <div class="panel-body">
                    <p>المبلغ: <strong>@df.FeeAmount.ToString("N3") د.ل</strong> | الإيصال: <strong>@df.ReceiptNumber</strong></p>
                    <small class="text-muted">تاريخ الدفع: @(df.PaidAt.HasValue ? df.PaidAt.Value.ToString("yyyy/MM/dd") : "-")</small>
                </div>
            </div>
        }
    </div>
</div>
